---
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import HeroSection from './HeroSection.astro';
import ScrollStory from './ScrollStory.astro';
import AiSimulator from './AiSimulator.astro';
import ScopeEstimator from './ScopeEstimator.astro';
import { homeCopy, siteConfig, type Lang } from '../data/i18n';
import { products } from '../data/products';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeCopy[lang];
---

<Navbar lang={lang} enHref="/" ukHref="/uk" />

<main class="flex-1">
  <!-- 1. INTERACTIVE CANVAS HERO & LIVE TELEMETRY -->
  <HeroSection lang={lang} />

  <!-- 2. PINNED SCROLL STORYTELLING (4 STAGES) -->
  <ScrollStory lang={lang} />

  <!-- 3. INTERACTIVE LIVE AI WORKFLOW SIMULATOR -->
  <AiSimulator lang={lang} />

  <!-- 4. INTERACTIVE SCOPE & BUDGET ESTIMATOR -->
  <ScopeEstimator lang={lang} />

  <!-- 5. ZERO-RISK 48-HOUR FREE TECHNICAL BLUEPRINT OFFER (SWISS ARCHITECTURAL GRID) -->
  <section class="py-16 sm:py-20 lg:py-24 border-t swiss-frame bg-[#050507]">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div data-reveal class="swiss-cell crosshair spotlight-card border p-5 sm:p-10 lg:p-14">
        <div class="max-w-3xl mb-7 sm:mb-10">
          <span class="inline-flex items-center gap-2 px-3 py-1 border border-[#00E599]/35 bg-[#00E599]/10 text-[#00E599] font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.14em] mb-4 sm:mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#00E599]"></span>
            {t.blueprintOffer.badge}
          </span>
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-[-0.03em] leading-[1.08] sm:leading-[1.05] mb-3.5 sm:mb-4 break-words">
            {t.blueprintOffer.title}
          </h2>
          <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">{t.blueprintOffer.desc}</p>
        </div>

        <div data-stagger-group class="grid md:grid-cols-3 border swiss-frame divide-y md:divide-y-0 md:divide-x divide-white/[0.08] bg-black/50 mb-7 sm:mb-10">
          {t.blueprintOffer.deliverables.map((d) => (
            <div data-stagger-item class="p-5 sm:p-6">
              <span class="font-mono text-xs font-bold text-[#00E599] block mb-2.5 sm:mb-3">{d.num} //</span>
              <h3 class="text-base font-display font-bold text-white mb-1.5 sm:mb-2">{d.title}</h3>
              <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">{d.desc}</p>
            </div>
          ))}
        </div>

        <button
          type="button"
          data-prefill-service="blueprint"
          class="prefill-cta magnetic-btn w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-4 rounded-xl bg-white hover:bg-[#00E599] text-black font-bold text-sm sm:text-base transition-colors cursor-pointer"
        >
          <span>{t.blueprintOffer.cta}</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 6. ENGAGEMENT MODELS (EXPOSED 1PX SWISS GRID) -->
  <section id="services" class="py-16 sm:py-20 lg:py-24 border-t swiss-frame bg-[#07080B]">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div data-reveal class="flex flex-col lg:flex-row lg:items-end justify-between gap-3 sm:gap-4 mb-8 sm:mb-12">
        <div>
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-[#00E599] mb-2">04 // {t.services.eyebrow}</p>
          <h2 class="text-2xl sm:text-4xl font-display font-bold text-white tracking-[-0.03em] break-words">{t.services.title}</h2>
        </div>
        <p class="text-zinc-400 text-sm max-w-md">{t.services.subtitle}</p>
      </div>

      <div data-stagger-group class="grid md:grid-cols-3 border swiss-frame divide-y md:divide-y-0 md:divide-x divide-white/[0.08]">
        {t.services.items.map((svc) => (
          <div data-stagger-item class="swiss-cell spotlight-card p-6 sm:p-8 flex flex-col justify-between hover:bg-white/[0.03] transition">
            <div>
              <div class="flex items-center justify-between gap-2 mb-5 sm:mb-6 font-mono text-[11px]">
                <span class="text-[#00E599] font-semibold">{svc.num} // {svc.tag}</span>
                <span class="px-2.5 py-0.5 border border-white/10 text-zinc-300 shrink-0">{svc.timeline}</span>
              </div>
              <h3 class="text-lg sm:text-xl font-display font-bold text-white mb-2.5 sm:mb-3">{svc.title}</h3>
              <p class="text-sm text-zinc-400 leading-relaxed mb-5 sm:mb-6">{svc.desc}</p>
              <ul class="space-y-2.5 text-sm text-zinc-300 mb-6 sm:mb-8">
                {svc.bullets.map((b) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-[#00E599] font-mono font-bold mt-0.5">+</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 sm:pt-5 border-t swiss-frame flex flex-wrap items-center justify-between gap-3">
              <span class="text-xs font-mono text-zinc-500">{svc.model}</span>
              <button
                type="button"
                data-prefill-service={svc.id}
                class="prefill-cta text-xs font-mono font-bold uppercase tracking-wider text-white hover:text-[#00E599] transition cursor-pointer"
              >
                {svc.cta} →
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. VANZALABS R&D LAB (REFRAMED 4 LIVE APPS) -->
  <section id="lab" class="py-16 sm:py-20 lg:py-28 border-t border-white/[0.06]">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div data-reveal class="max-w-2xl mb-8 sm:mb-10">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2.5 sm:mb-3">{t.lab.eyebrow}</p>
        <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight mb-3 break-words">{t.lab.title}</h2>
        <p class="text-gray-400 text-sm sm:text-base leading-relaxed">{t.lab.subtitle}</p>
      </div>

      <!-- Compact 4-App Selector -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3 mb-5 sm:mb-6">
        {products.map((p, idx) => (
          <button
            type="button"
            data-showcase-tab={p.slug}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class:list={[
              'showcase-tab text-left p-2.5 sm:p-3.5 rounded-2xl border transition cursor-pointer flex items-center gap-2.5 sm:gap-3',
              idx === 0
                ? 'bg-[#121722] border-emerald-400/50 text-white shadow-lg'
                : 'bg-white/[0.02] border-white/[0.08] text-gray-400 hover:border-white/20 hover:text-white',
            ]}
          >
            <img
              src={p.icon}
              alt={p.shortName}
              class:list={[
                'w-9 h-9 sm:w-10 sm:h-10 rounded-xl shrink-0 bg-black border border-white/10',
                p.slug === 'spot' ? 'object-contain p-1.5' : 'object-cover',
              ]}
              loading="lazy"
            />
            <div class="min-w-0">
              <p class="font-display font-bold text-xs sm:text-sm truncate text-white">{p.shortName}</p>
              <p class="text-[10px] sm:text-[11px] text-gray-400 truncate">{p[lang].badge.split('·')[1]?.trim() || p.category}</p>
            </div>
          </button>
        ))}
      </div>

      <!-- Active Product Showcase Card (Clean, No Screenshots) -->
      {products.map((p, idx) => {
        const copy = p[lang];
        return (
          <div
            data-showcase-panel={p.slug}
            class:list={[
              'showcase-panel glass-panel spotlight-card rounded-2xl sm:rounded-3xl p-5 sm:p-8 lg:p-10 relative overflow-hidden',
              idx !== 0 && 'hidden',
            ]}
          >
            <div class="space-y-5 sm:space-y-6 relative z-10">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                <div class="space-y-2.5 min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class:list={['px-3 py-1 rounded-full text-[11px] sm:text-xs font-mono font-semibold border', p.accentBgClass, p.accentTextClass, p.accentBorderClass]}>
                      {copy.badge}
                    </span>
                    <span class="hidden sm:inline-block px-2.5 py-1 rounded-full bg-white/5 text-gray-400 text-xs font-mono">{p.packageId}</span>
                  </div>
                  <h3 class="text-xl sm:text-3xl font-bold text-white tracking-tight">{p.name}</h3>
                  <p class="text-gray-300 text-sm sm:text-base leading-relaxed max-w-3xl">{copy.summary}</p>
                </div>
              </div>

              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3">
                {copy.features.map((f) => (
                  <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/[0.06]">
                    <p class="text-xs font-bold text-white mb-1">{f.title}</p>
                    <p class="text-xs text-gray-400 leading-relaxed">{f.desc}</p>
                  </div>
                ))}
              </div>

              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 border-t border-white/[0.06]">
                <div class="flex flex-wrap gap-1.5">
                  {p.stack.map((tech) => (
                    <span class="px-2.5 py-1 rounded-md bg-white/[0.05] text-gray-300 text-xs font-mono">{tech}</span>
                  ))}
                </div>

                <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 shrink-0">
                  <a
                    href={lang === 'uk' ? `/uk/${p.slug}` : `/${p.slug}`}
                    class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-4 py-3 sm:py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white text-xs font-semibold transition"
                  >
                    <span>{t.lab.visitProduct}</span>
                    <span>↗</span>
                  </a>
                  <a
                    href={p.playStoreUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-4 py-3 sm:py-2.5 rounded-xl border border-white/15 hover:border-white/30 text-gray-200 text-xs font-semibold transition"
                  >
                    <span>Google Play ↗</span>
                  </a>
                  <button
                    type="button"
                    data-prefill-service="mobile"
                    data-prefill-product={p.shortName}
                    class="prefill-cta w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-3 sm:py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-gray-950 text-xs font-bold transition cursor-pointer"
                  >
                    <span>{t.lab.buildSimilar}</span>
                    <span>→</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 8. FOUNDERS & CORE STACK -->
  <section id="founders" class="py-16 sm:py-20 lg:py-28 border-t border-white/[0.06] bg-[#0A0C11]">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-12 lg:mb-16">
        <div data-reveal class="lg:col-span-5">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2.5 sm:mb-3">{t.founders.eyebrow}</p>
          <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight mb-3.5 sm:mb-4 break-words">{t.founders.title}</h2>
          <p class="text-gray-400 text-sm sm:text-base leading-relaxed">{t.founders.subtitle}</p>
        </div>

        <div data-stagger-group class="lg:col-span-7 grid sm:grid-cols-2 gap-4 sm:gap-5">
          {t.founders.people.map((person) => (
            <div data-stagger-item class="glass-panel spotlight-card rounded-2xl sm:rounded-3xl p-5 sm:p-6 flex flex-col">
              <div class="flex items-center gap-4 mb-4">
                <img
                  src={person.img}
                  alt={person.name}
                  loading="lazy"
                  decoding="async"
                  class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl object-cover object-top border border-white/15 shrink-0"
                />
                <div class="min-w-0">
                  <h3 class="text-base sm:text-lg font-bold text-white">{person.name}</h3>
                  <p class="text-xs font-mono text-emerald-400">{person.role}</p>
                </div>
              </div>
              <p class="text-sm text-gray-400 leading-relaxed">{person.bio}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="pt-10 sm:pt-12 border-t border-white/[0.06]">
        <p class="font-mono text-xs uppercase tracking-widest text-gray-500 mb-5 sm:mb-6">{t.founders.stackTitle}</p>
        <div data-stagger-group class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {t.founders.stackGroups.map((group) => (
            <div data-stagger-item class="p-4 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06]">
              <p class="text-xs font-semibold text-white mb-3">{group.label}</p>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((tech) => (
                  <span class="px-2.5 py-1 rounded-md bg-white/[0.05] text-gray-300 text-xs font-mono">{tech}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section id="faq" class="py-16 sm:py-20 lg:py-24 border-t border-white/[0.06]">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-8 sm:mb-12">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2.5 sm:mb-3">{t.faq.eyebrow}</p>
        <h2 class="text-2xl sm:text-4xl font-bold text-white break-words">{t.faq.title}</h2>
      </div>

      <div data-stagger-group class="space-y-3">
        {t.faq.items.map((item) => (
          <details data-stagger-item class="group rounded-2xl border border-white/[0.08] bg-white/[0.02] open:border-emerald-500/35 transition">
            <summary class="flex items-center justify-between gap-4 px-4 sm:px-6 py-4 sm:py-5 cursor-pointer list-none font-semibold text-white text-sm sm:text-base">
              <span>{item.q}</span>
              <span class="text-emerald-400 font-mono text-lg shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="px-4 sm:px-6 pb-4 sm:pb-5 text-sm text-gray-400 leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. CONTACT / FREE 48H BLUEPRINT FORM -->
  <section id="contact" class="py-16 sm:py-20 lg:py-28 border-t border-white/[0.06] bg-[#0A0C11] relative overflow-hidden">
    <div class="absolute bottom-0 right-0 w-[560px] h-[360px] bg-emerald-500/12 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div data-reveal class="lg:col-span-5 space-y-5 sm:space-y-6">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-emerald-400">{t.contact.eyebrow}</p>
          <h2 class="text-2xl sm:text-4xl font-bold text-white leading-tight break-words">{t.contact.title}</h2>
          <p class="text-gray-400 text-sm sm:text-base leading-relaxed">{t.contact.subtitle}</p>

          <ul class="space-y-2.5 sm:space-y-3 text-sm text-gray-300">
            {t.contact.perks.map((perk) => (
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0">✓</span>
                <span>{perk}</span>
              </li>
            ))}
          </ul>

          <div class="pt-5 sm:pt-6 border-t border-white/10 space-y-3">
            <p class="text-xs font-mono text-gray-500 uppercase tracking-wider">{t.contact.directLabel}</p>
            <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2.5 sm:gap-3">
              <a
                href={siteConfig.telegram}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 sm:py-2.5 rounded-xl bg-[#229ED9]/20 hover:bg-[#229ED9]/30 border border-[#229ED9]/40 text-sky-300 text-sm font-semibold transition"
              >
                <span>{t.contact.telegramCta} ({siteConfig.telegramHandle})</span>
              </a>
              <a
                href={`mailto:${siteConfig.email}`}
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 sm:py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-200 text-sm font-medium transition"
              >
                <span>{siteConfig.email}</span>
              </a>
            </div>
          </div>
        </div>

        <div data-reveal class="lg:col-span-7 glass-panel spotlight-card rounded-2xl sm:rounded-3xl p-5 sm:p-8">
          <form
            id="contactForm"
            action={siteConfig.formspreeAction}
            method="POST"
            data-lang={lang}
            data-sending={t.contact.form.sending}
            data-error={t.contact.form.error}
            class="space-y-4"
          >
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5" for="f-name">{t.contact.form.name}</label>
                <input
                  id="f-name"
                  type="text"
                  name="name"
                  required
                  placeholder={t.contact.form.namePh}
                  class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-gray-500 focus:border-emerald-400 focus:outline-none text-base sm:text-sm"
                />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5" for="f-email">{t.contact.form.email}</label>
                <input
                  id="f-email"
                  type="email"
                  name="email"
                  required
                  placeholder={t.contact.form.emailPh}
                  class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-gray-500 focus:border-emerald-400 focus:outline-none text-base sm:text-sm"
                />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5" for="f-company">{t.contact.form.company}</label>
                <input
                  id="f-company"
                  type="text"
                  name="company"
                  placeholder={t.contact.form.companyPh}
                  class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-gray-500 focus:border-emerald-400 focus:outline-none text-base sm:text-sm"
                />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1.5" for="f-service">{t.contact.form.service}</label>
                <select
                  id="f-service"
                  name="service"
                  required
                  class="w-full px-4 py-3 rounded-xl bg-[#0B0E14] border border-white/10 text-white focus:border-emerald-400 focus:outline-none text-base sm:text-sm"
                >
                  <option value="">{t.contact.form.servicePlaceholder}</option>
                  {t.contact.form.options.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-medium text-gray-400 mb-1.5" for="f-message">{t.contact.form.message}</label>
              <textarea
                id="f-message"
                name="message"
                rows="4"
                required
                placeholder={t.contact.form.messagePh}
                class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/10 text-white placeholder-gray-500 focus:border-emerald-400 focus:outline-none text-base sm:text-sm resize-y"
              ></textarea>
            </div>

            <div class="flex items-start gap-2.5">
              <input
                type="checkbox"
                id="f-privacy"
                name="privacy"
                required
                class="mt-0.5 w-4 h-4 accent-emerald-500 rounded"
              />
              <label for="f-privacy" class="text-xs text-gray-400 leading-relaxed">
                {t.contact.form.privacyPrefix}{' '}
                <a href="/privacy-policy" class="text-emerald-400 hover:underline">{t.contact.form.privacyLink}</a>
              </label>
            </div>

            <button
              id="submitBtn"
              type="submit"
              class="w-full py-3.5 px-6 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-gray-950 font-bold text-sm transition cursor-pointer glow-emerald"
            >
              {t.contact.form.submit} →
            </button>
            <p class="text-xs text-gray-500 text-center">{t.contact.form.note}</p>
            <p id="formStatus" class="hidden text-center text-sm text-red-400"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer lang={lang} />

<script is:inline>
  (() => {
    function bindHomeInteractions() {
      const form = document.getElementById('contactForm');
      if (form && form.dataset.bound === 'true') return;
      if (form) form.dataset.bound = 'true';

      // R&D Lab Showcase Tabs
      document.querySelectorAll('.showcase-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const slug = tab.dataset.showcaseTab;
          document.querySelectorAll('.showcase-tab').forEach((b) => {
            const active = b.dataset.showcaseTab === slug;
            b.setAttribute('aria-pressed', String(active));
            b.className = `showcase-tab text-left p-2.5 sm:p-3.5 rounded-2xl border transition cursor-pointer flex items-center gap-2.5 sm:gap-3 ${
              active
                ? 'bg-[#121722] border-[#00E599]/50 text-white shadow-lg'
                : 'bg-white/[0.02] border-white/[0.08] text-zinc-400 hover:border-white/20 hover:text-white'
            }`;
          });
          document.querySelectorAll('.showcase-panel').forEach((panel) => {
            panel.classList.toggle('hidden', panel.dataset.showcasePanel !== slug);
          });
          if (window.posthog) window.posthog.capture('app_showcase_switched', { app: slug });
        });
      });

      // Prefill service CTA buttons
      document.querySelectorAll('.prefill-cta').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const svc = btn.dataset.prefillService;
          const prod = btn.dataset.prefillProduct;
          const select = document.querySelector('select[name="service"]');
          if (select && svc) select.value = svc;
          if (prod) {
            const msg = document.querySelector('textarea[name="message"]');
            if (msg && !msg.value.trim()) {
              const isUk = document.documentElement.lang === 'uk';
              msg.value = isUk
                ? `Цікавить розробка продукту, подібного до ${prod}. `
                : `Interested in building a product similar to ${prod}. `;
            }
          }
          const target = document.getElementById('contact');
          if (target) {
            if (btn.tagName === 'A') e.preventDefault();
            if (window.__lenis) {
              window.__lenis.scrollTo(target, { offset: -64 });
            } else {
              target.scrollIntoView({ behavior: 'smooth' });
            }
          }
        });
      });

      // Formspree AJAX handler
      const submitBtn = document.getElementById('submitBtn');
      const status = document.getElementById('formStatus');
      if (form && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }
          const originalText = submitBtn.textContent;
          submitBtn.disabled = true;
          submitBtn.textContent = form.dataset.sending || 'Sending...';
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });
            if (!res.ok) throw new Error('Submit failed');
            if (window.posthog) {
              window.posthog.capture('lead_form_submitted', {
                service: form.querySelector('select[name="service"]')?.value || 'general',
                lang: form.dataset.lang,
              });
            }
            window.location.href = `/thank-you?lang=${form.dataset.lang || 'en'}`;
          } catch {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
            if (status) {
              status.textContent = form.dataset.error || 'Error submitting form.';
              status.classList.remove('hidden');
            }
          }
        });
      }
    }

    document.addEventListener('astro:page-load', bindHomeInteractions);
    bindHomeInteractions();
  })();
</script>
