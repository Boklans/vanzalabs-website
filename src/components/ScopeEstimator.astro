---
import { homeCopy, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeCopy[lang].estimator;
const configJson = JSON.stringify({
  lang,
  types: t.types,
  modules: t.modules,
  designs: t.designs,
  weeksUnit: t.weeksUnit,
});
---

<section id="estimator" class="py-16 sm:py-20 lg:py-28 border-t border-white/[0.06] relative overflow-hidden">
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-72 bg-emerald-500/10 blur-3xl rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 relative z-10">
    <div data-reveal class="max-w-2xl mb-7 sm:mb-12">
      <p class="font-mono text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-2 sm:mb-3">{t.eyebrow}</p>
      <h2 class="text-2xl sm:text-4xl font-bold text-white tracking-tight mb-2.5 sm:mb-3 break-words">{t.title}</h2>
      <p class="text-gray-400 text-sm sm:text-base leading-relaxed">{t.subtitle}</p>
    </div>

    <div
      id="scopeEstimatorRoot"
      data-config={configJson}
      class="grid lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-8 items-start"
    >
      <!-- Left controls (7 cols) -->
      <div data-reveal class="lg:col-span-7 glass-panel rounded-2xl sm:rounded-3xl p-4 sm:p-8 space-y-5 sm:space-y-8">
        <!-- Step 1: Project Type -->
        <div>
          <p class="text-[11px] sm:text-xs font-mono uppercase tracking-wider text-gray-400 mb-2 sm:mb-3">{t.step1}</p>
          <div class="grid grid-cols-3 gap-1.5 sm:gap-2.5" role="radiogroup" aria-label={t.step1}>
            {t.types.map((item, idx) => {
              const shortLabel =
                item.id === 'mvp'
                  ? (lang === 'uk' ? 'Веб / MVP' : 'Web / MVP')
                  : item.id === 'mobile'
                    ? (lang === 'uk' ? 'Мобільний' : 'Mobile App')
                    : (lang === 'uk' ? 'AI & CRM' : 'AI & CRM');
              return (
                <button
                  type="button"
                  data-est-type={item.id}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                  class:list={[
                    'est-type-btn text-center sm:text-left px-2 py-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border text-[11px] sm:text-sm font-semibold transition cursor-pointer',
                    idx === 0
                      ? 'bg-[#00E599]/15 border-[#00E599]/60 text-white'
                      : 'bg-white/[0.02] border-white/10 text-zinc-300 hover:border-white/25 hover:text-white',
                  ]}
                >
                  <span class="sm:hidden">{shortLabel}</span>
                  <span class="hidden sm:inline">{item.label}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Step 2: Modules -->
        <div>
          <p class="text-[11px] sm:text-xs font-mono uppercase tracking-wider text-gray-400 mb-2 sm:mb-3">{t.step2}</p>
          <div class="flex flex-wrap gap-1.5 sm:grid sm:grid-cols-2 sm:gap-2.5">
            {t.modules.map((mod) => (
              <button
                type="button"
                data-est-mod={mod.id}
                aria-pressed="false"
                class="est-mod-btn inline-flex sm:flex items-center justify-between gap-2 px-3 py-2 sm:p-3.5 rounded-full sm:rounded-xl border bg-white/[0.02] border-white/10 text-zinc-300 hover:border-white/25 hover:text-white text-xs sm:text-sm font-medium transition cursor-pointer"
              >
                <span class="text-left leading-snug">{mod.label}</span>
                <span class="est-check w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-full sm:rounded-md border border-white/20 flex items-center justify-center text-[10px] sm:text-xs text-transparent transition">✓</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Step 3: Design -->
        <div>
          <p class="text-[11px] sm:text-xs font-mono uppercase tracking-wider text-gray-400 mb-2 sm:mb-3">{t.step3}</p>
          <div class="grid grid-cols-2 gap-1.5 sm:gap-2.5">
            {t.designs.map((d, idx) => (
              <button
                type="button"
                data-est-design={d.id}
                aria-pressed={idx === 1 ? 'true' : 'false'}
                class:list={[
                  'est-design-btn text-left p-2.5 sm:p-3.5 rounded-xl border text-[11px] sm:text-sm font-medium leading-snug transition cursor-pointer',
                  idx === 1
                    ? 'bg-[#00E599]/15 border-[#00E599]/60 text-white'
                    : 'bg-white/[0.02] border-white/10 text-zinc-300 hover:border-white/25 hover:text-white',
                ]}
              >
                {d.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Right live summary card (5 cols) -->
      <div data-reveal class="lg:col-span-5 bg-gradient-to-b from-[#111622] to-[#0B0E15] rounded-2xl sm:rounded-3xl p-4 sm:p-8 border border-emerald-500/25 shadow-2xl space-y-4 sm:space-y-6 lg:sticky lg:top-24">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs uppercase tracking-wider text-emerald-400 font-semibold">{t.resultTitle}</span>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-gray-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Live
          </span>
        </div>

        <div class="grid grid-cols-2 gap-2.5 sm:gap-4">
          <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white/[0.03] border border-white/[0.06] min-w-0">
            <p class="text-[11px] sm:text-xs text-gray-400 mb-0.5 sm:mb-1">{t.timelineLabel}</p>
            <p id="estTimelineOut" class="text-lg sm:text-2xl font-display font-bold text-white leading-tight">5–7 {t.weeksUnit}</p>
          </div>
          <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white/[0.03] border border-white/[0.06] min-w-0">
            <p class="text-[11px] sm:text-xs text-gray-400 mb-0.5 sm:mb-1">{t.budgetLabel}</p>
            <p id="estBudgetOut" class="text-lg sm:text-2xl font-display font-bold text-emerald-400 leading-tight">$7.3k–$12.5k</p>
          </div>
        </div>

        <div>
          <p class="text-xs text-gray-400 mb-2.5">{t.stackLabel}</p>
          <div id="estStackOut" class="flex flex-wrap gap-2">
            {t.types[0].stack.map((tech) => (
              <span class="px-2.5 py-1 rounded-lg bg-white/[0.05] border border-white/10 text-xs font-mono text-gray-200">{tech}</span>
            ))}
          </div>
        </div>

        <button
          id="estApplyBtn"
          type="button"
          class="w-full py-3.5 px-5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-gray-950 font-bold text-sm transition cursor-pointer glow-emerald"
        >
          {t.cta}
        </button>

        <p class="text-xs text-gray-500 leading-relaxed">{t.disclaimer}</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function bindScopeEstimator() {
      const root = document.getElementById('scopeEstimatorRoot');
      if (!root || root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const cfg = JSON.parse(root.dataset.config || '{}');

      let selectedType = cfg.types[0].id;
      const selectedModules = new Set();
      let selectedDesign = cfg.designs[1]?.id || cfg.designs[0].id;

      const timelineOut = document.getElementById('estTimelineOut');
      const budgetOut = document.getElementById('estBudgetOut');
      const stackOut = document.getElementById('estStackOut');
      const applyBtn = document.getElementById('estApplyBtn');

      function formatK(val) {
        return '$' + (val / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
      }

      function recalculate() {
        const typeObj = cfg.types.find((x) => x.id === selectedType) || cfg.types[0];
        const designObj = cfg.designs.find((x) => x.id === selectedDesign) || cfg.designs[0];

        let weeks = typeObj.baseWeeks + designObj.weeks;
        let minB = typeObj.baseMin + designObj.min;
        let maxB = typeObj.baseMax + designObj.max;

        const stack = new Set(typeObj.stack);
        selectedModules.forEach((modId) => {
          const mod = cfg.modules.find((m) => m.id === modId);
          if (!mod) return;
          weeks += mod.weeks;
          minB += mod.min;
          maxB += mod.max;
          if (modId === 'ai') stack.add('OpenAI / RAG');
          if (modId === 'payments') stack.add('Stripe');
          if (modId === 'offline') stack.add('Local-First Sync');
        });

        const minW = Math.max(2, Math.floor(weeks));
        const maxW = Math.ceil(weeks + 2);

        if (timelineOut) timelineOut.textContent = `${minW}–${maxW} ${cfg.weeksUnit}`;
        if (budgetOut) budgetOut.textContent = `${formatK(minB)}–${formatK(maxB)}`;
        if (stackOut) {
          stackOut.innerHTML = Array.from(stack)
            .map((s) => `<span class="px-2.5 py-1 rounded-lg bg-white/[0.05] border border-white/10 text-xs font-mono text-zinc-200">${s}</span>`)
            .join('');
        }
        return { typeObj, designObj, minW, maxW, minB, maxB };
      }

      root.querySelectorAll('.est-type-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedType = btn.dataset.estType;
          root.querySelectorAll('.est-type-btn').forEach((b) => {
            const active = b.dataset.estType === selectedType;
            b.setAttribute('aria-pressed', String(active));
            b.className = `est-type-btn text-center sm:text-left px-2 py-2.5 sm:p-3.5 rounded-xl sm:rounded-2xl border text-[11px] sm:text-sm font-semibold transition cursor-pointer ${
              active
                ? 'bg-[#00E599]/15 border-[#00E599]/60 text-white'
                : 'bg-white/[0.02] border-white/10 text-zinc-300 hover:border-white/25 hover:text-white'
            }`;
          });
          recalculate();
        });
      });

      root.querySelectorAll('.est-mod-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.estMod;
          if (selectedModules.has(id)) selectedModules.delete(id);
          else selectedModules.add(id);
          const active = selectedModules.has(id);
          btn.setAttribute('aria-pressed', String(active));
          btn.className = `est-mod-btn inline-flex sm:flex items-center justify-between gap-2 px-3 py-2 sm:p-3.5 rounded-full sm:rounded-xl border text-xs sm:text-sm font-medium transition cursor-pointer ${
            active
              ? 'bg-[#00E599]/15 border-[#00E599]/60 text-white'
              : 'bg-white/[0.02] border-white/10 text-zinc-300 hover:border-white/25 hover:text-white'
          }`;
          const check = btn.querySelector('.est-check');
          if (check) {
            check.className = `est-check w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-full sm:rounded-md border flex items-center justify-center text-[10px] sm:text-xs transition ${
              active ? 'bg-[#00E599] border-[#00E599] text-black font-bold' : 'border-white/20 text-transparent'
            }`;
          }
          recalculate();
        });
      });

      root.querySelectorAll('.est-design-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedDesign = btn.dataset.estDesign;
          root.querySelectorAll('.est-design-btn').forEach((b) => {
            const active = b.dataset.estDesign === selectedDesign;
            b.setAttribute('aria-pressed', String(active));
            b.className = `est-design-btn text-left p-2.5 sm:p-3.5 rounded-xl border text-[11px] sm:text-sm font-medium leading-snug transition cursor-pointer ${
              active
                ? 'bg-[#00E599]/15 border-[#00E599]/60 text-white'
                : 'bg-white/[0.02] border-white/10 text-zinc-300 hover:border-white/25 hover:text-white'
            }`;
          });
          recalculate();
        });
      });

      if (applyBtn) {
        applyBtn.addEventListener('click', () => {
          const res = recalculate();
          const modNames = Array.from(selectedModules)
            .map((id) => cfg.modules.find((m) => m.id === id)?.label)
            .filter(Boolean);

          const summary =
            cfg.lang === 'uk'
              ? `Конфігурація з калькулятора:\n• Тип: ${res.typeObj.label}\n• Модулі: ${modNames.length ? modNames.join(', ') : 'Базовий функціонал'}\n• Дизайн: ${res.designObj.label}\n• Орієнтир: ${res.minW}–${res.maxW} ${cfg.weeksUnit}, ${formatK(res.minB)}–${formatK(res.maxB)}\n\nКоротко про задачу: `
              : `Estimator Configuration:\n• Type: ${res.typeObj.label}\n• Modules: ${modNames.length ? modNames.join(', ') : 'Core scope'}\n• Design: ${res.designObj.label}\n• Estimate: ${res.minW}–${res.maxW} ${cfg.weeksUnit}, ${formatK(res.minB)}–${formatK(res.maxB)}\n\nProject notes: `;

          const select = document.querySelector('select[name="service"]');
          if (select) select.value = selectedType;

          const msg = document.querySelector('textarea[name="message"]');
          if (msg) msg.value = summary;

          if (window.posthog) {
            window.posthog.capture('estimator_cta_clicked', {
              type: selectedType,
              modules: Array.from(selectedModules),
              design: selectedDesign,
            });
          }

          const target = document.getElementById('contact');
          if (window.__lenis && target) window.__lenis.scrollTo(target, { offset: -64 });
          else target?.scrollIntoView({ behavior: 'smooth' });
        });
      }

      recalculate();
    }

    document.addEventListener('astro:page-load', bindScopeEstimator);
    bindScopeEstimator();
  })();
</script>
