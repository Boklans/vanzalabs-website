---
import { homeCopy, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeCopy[lang].hero;
---

<section data-hero-section class="relative overflow-hidden border-b swiss-frame">
  <!-- Real-Time WebGL GLSL Silk-Light Topographic Fluid Shader -->
  <canvas id="heroWebglCanvas" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="border-x swiss-frame min-h-[calc(100vh-8.5rem)] flex flex-col justify-between py-12 sm:py-16 lg:py-20 px-5 sm:px-8 lg:px-14">
      <!-- Top Metadata Strip -->
      <div
        data-hero-animate
        class="flex flex-wrap items-center justify-between gap-4 pb-7 border-b swiss-frame font-mono text-[11px] uppercase tracking-[0.16em] text-zinc-400"
      >
        <span class="inline-flex items-center gap-2.5 text-zinc-200">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00E599] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#00E599]"></span>
          </span>
          <span>{t.badge}</span>
        </span>
        <button
          type="button"
          data-open-cmd
          class="hidden sm:inline-flex items-center gap-2 text-zinc-400 hover:text-white transition cursor-pointer"
        >
          <span>{lang === 'uk' ? 'Швидке меню' : 'Command OS'}</span>
          <kbd class="px-1.5 py-0.5 rounded border border-white/15 bg-white/[0.04] text-[10px] text-zinc-200">⌘K</kbd>
        </button>
      </div>

      <!-- Centerpiece Monumental Editorial Typography -->
      <div class="my-auto py-12 sm:py-16 lg:py-20">
        <h1
          data-hero-animate
          class:list={[
            'font-display font-extrabold tracking-[-0.04em] leading-[1.02] text-white max-w-5xl',
            lang === 'uk'
              ? 'text-[clamp(2.35rem,5.4vw,4.9rem)]'
              : 'text-[clamp(2.85rem,6.4vw,5.9rem)]',
          ]}
        >
          <span class="text-gradient-metallic">{t.titleStart}</span>{' '}
          <span class="editorial-italic text-[#00E599] font-normal text-[1.16em] px-0.5">{t.titleHighlight}</span>{' '}
          <span class="text-white">{t.titleEnd}</span>
        </h1>
      </div>

      <!-- Bottom Split Row: Subtitle (left) + Magnetic CTAs (right) -->
      <div
        data-hero-animate
        class="pt-8 border-t swiss-frame grid lg:grid-cols-12 gap-6 lg:gap-8 items-end"
      >
        <p class="lg:col-span-6 text-zinc-300/90 text-base sm:text-lg leading-relaxed max-w-xl">
          {t.subtitle}
        </p>

        <div class="lg:col-span-6 flex flex-wrap lg:justify-end items-center gap-3.5">
          <a
            href="#contact"
            data-prefill-service="blueprint"
            class="prefill-cta magnetic-btn inline-flex items-center gap-3 px-7 py-4 rounded-xl bg-white hover:bg-[#00E599] text-black font-bold text-sm sm:text-base transition-colors duration-200"
          >
            <span>{t.primaryCta}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#estimator"
            class="inline-flex items-center gap-2 px-6 py-4 rounded-xl border border-white/15 bg-black/45 hover:bg-white/[0.08] backdrop-blur-md text-zinc-100 font-semibold text-sm sm:text-base transition"
          >
            <span>{t.secondaryCta}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Continuous Architectural Marquee Ticker -->
  <div class="relative z-10 border-t swiss-frame bg-[#050507]/85 backdrop-blur-md py-3.5 overflow-hidden">
    <div class="marquee-track font-mono text-[11px] uppercase tracking-[0.18em] text-zinc-400">
      {[0, 1].map(() => (
        <div class="flex items-center shrink-0">
          {t.trustRibbon.map((item) => (
            <span class="inline-flex items-center gap-6 px-6">
              <span>{item}</span>
              <span class="text-[#00E599]/70">+</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
