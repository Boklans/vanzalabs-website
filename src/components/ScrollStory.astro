---
import { homeCopy, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = homeCopy[lang].story;
---

<section id="story" class="relative border-b swiss-frame bg-[#050507]">
  <!-- Desktop Pinned Scroll Track (330vh) -->
  <div id="scrollStoryTrack" class="relative lg:min-h-[330vh]">
    <div class="lg:sticky lg:top-16 lg:h-[calc(100vh-4rem)] lg:flex lg:items-center py-20 lg:py-0 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <!-- Header Row -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-8 mb-8 border-b swiss-frame">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#00E599] mb-2">01 // {t.eyebrow}</p>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold tracking-[-0.03em] text-white">{t.title}</h2>
          </div>
          <p class="text-zinc-400 text-sm max-w-md">{t.subtitle}</p>
        </div>

        <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          <!-- Left: 4 Scroll-Synchronized Blueprint Chapters (5 cols) -->
          <div class="lg:col-span-5 relative pl-6">
            <div class="absolute left-0 top-1 bottom-1 w-[3px] bg-white/10 overflow-hidden">
              <div
                id="storyRailFill"
                class="w-full h-full origin-top will-change-transform bg-gradient-to-b from-[#00E599] via-teal-300 to-sky-400 shadow-[0_0_14px_rgba(0,229,153,0.95)]"
                style="transform: scaleY(0.06);"
              ></div>
            </div>

            <div class="space-y-3">
              {t.chapters.map((ch, idx) => (
                <button
                  type="button"
                  data-story-step={idx}
                  class:list={[
                    'story-step-card w-full text-left p-4 border transition-all duration-300 cursor-pointer',
                    idx === 0
                      ? 'bg-white/[0.05] border-[#00E599]/50 opacity-100'
                      : 'bg-transparent border-white/[0.06] opacity-45 hover:opacity-85',
                  ]}
                >
                  <div class="flex items-center justify-between mb-1 font-mono text-[10px] tracking-[0.14em]">
                    <span class="font-bold text-[#00E599]">{ch.num} // {ch.tag}</span>
                    <span class="text-zinc-500">{ch.time}</span>
                  </div>
                  <h3 class="text-base font-display font-bold text-white mb-1">{ch.title}</h3>
                  <p class="text-xs sm:text-[13px] text-zinc-400 leading-relaxed">{ch.desc}</p>
                </button>
              ))}
            </div>
          </div>

          <!-- Right: Clip-Path Morphing Swiss Stage (7 cols) -->
          <div class="lg:col-span-7">
            <div class="swiss-cell crosshair relative border p-6 sm:p-8 min-h-[380px] sm:min-h-[440px] flex items-center justify-center overflow-hidden">
              <div class="absolute inset-0 bg-grid-pattern opacity-60 pointer-events-none"></div>

              <!-- STAGE 0: System Architecture Blueprint SVG -->
              <div data-story-stage="0" class="story-stage-pane relative z-10 w-full transition-all duration-500 opacity-100 scale-100">
                <div class="flex items-center justify-between font-mono text-[11px] text-[#00E599] mb-5">
                  <span>SPEC // SYSTEM_ARCHITECTURE.SVG</span>
                  <span class="px-2 py-0.5 border border-[#00E599]/35 bg-[#00E599]/10">01 / 04</span>
                </div>
                <svg viewBox="0 0 560 270" class="w-full h-auto" fill="none">
                  <path d="M130 135 H 215" stroke="#00E599" stroke-width="2" class="svg-cable-flow" />
                  <path d="M345 135 C 385 135, 385 60, 425 60" stroke="#00E599" stroke-width="2" class="svg-cable-flow" />
                  <path d="M345 135 H 425" stroke="#60A5FA" stroke-width="2" class="svg-cable-flow" />
                  <path d="M345 135 C 385 135, 385 210, 425 210" stroke="#C084FC" stroke-width="2" class="svg-cable-flow" />

                  <rect x="10" y="95" width="120" height="80" fill="#090A0F" stroke="rgba(255,255,255,0.22)" stroke-width="1.2" />
                  <text x="70" y="130" text-anchor="middle" fill="#FFFFFF" font-size="13" font-weight="700" font-family="Plus Jakarta Sans">Web / Mobile</text>
                  <text x="70" y="150" text-anchor="middle" fill="#A1A1AA" font-size="10" font-family="JetBrains Mono">Next.js · Flutter</text>

                  <rect x="215" y="88" width="130" height="94" fill="#00E599" fill-opacity="0.08" stroke="#00E599" stroke-width="1.6" />
                  <text x="280" y="128" text-anchor="middle" fill="#00E599" font-size="13" font-weight="700" font-family="Plus Jakarta Sans">Edge API Core</text>
                  <text x="280" y="148" text-anchor="middle" fill="#D4D4D8" font-size="10" font-family="JetBrains Mono">Auth · Rate Limit</text>
                  <text x="280" y="164" text-anchor="middle" fill="#A1A1AA" font-size="10" font-family="JetBrains Mono">Type-Safe RPC</text>

                  <rect x="425" y="25" width="125" height="68" fill="#090A0F" stroke="rgba(0,229,153,0.45)" stroke-width="1.2" />
                  <text x="487" y="56" text-anchor="middle" fill="#FFFFFF" font-size="12" font-weight="700" font-family="Plus Jakarta Sans">PostgreSQL</text>
                  <text x="487" y="74" text-anchor="middle" fill="#A1A1AA" font-size="10" font-family="JetBrains Mono">RLS · Backups</text>

                  <rect x="425" y="101" width="125" height="68" fill="#090A0F" stroke="rgba(96,165,250,0.5)" stroke-width="1.2" />
                  <text x="487" y="132" text-anchor="middle" fill="#93C5FD" font-size="12" font-weight="700" font-family="Plus Jakarta Sans">LLM + RAG</text>
                  <text x="487" y="150" text-anchor="middle" fill="#A1A1AA" font-size="10" font-family="JetBrains Mono">OpenAI · Vector</text>

                  <rect x="425" y="177" width="125" height="68" fill="#090A0F" stroke="rgba(192,132,252,0.5)" stroke-width="1.2" />
                  <text x="487" y="208" text-anchor="middle" fill="#E9D5FF" font-size="12" font-weight="700" font-family="Plus Jakarta Sans">CRM &amp; Stripe</text>
                  <text x="487" y="226" text-anchor="middle" fill="#A1A1AA" font-size="10" font-family="JetBrains Mono">Webhooks · Sync</text>
                </svg>
              </div>

              <!-- STAGE 1: Clean Type-Safe Engineering Code -->
              <div data-story-stage="1" class="story-stage-pane absolute inset-6 sm:inset-8 z-10 flex flex-col justify-center transition-all duration-500 opacity-0 scale-[0.97] pointer-events-none">
                <div class="flex items-center justify-between font-mono text-[11px] text-sky-400 mb-4">
                  <span>REPO // client-org/core/pipeline.ts</span>
                  <span class="px-2 py-0.5 border border-sky-400/35 bg-sky-400/10">02 / 04</span>
                </div>
                <pre class="p-4 sm:p-5 border border-white/10 bg-black/80 font-mono text-xs sm:text-[13px] leading-relaxed text-zinc-300 overflow-x-auto"><code><span class="text-purple-400">export async function</span> <span class="text-sky-300">processClientOrder</span>(payload: <span class="text-[#00E599]">OrderDTO</span>) &#123;
  <span class="text-zinc-500">// 1. Validate schema &amp; enrich via RAG</span>
  <span class="text-purple-400">const</span> verified = OrderSchema.<span class="text-sky-300">parse</span>(payload);
  <span class="text-purple-400">const</span> quote = <span class="text-purple-400">await</span> aiEngine.<span class="text-sky-300">estimate</span>(verified);

  <span class="text-zinc-500">// 2. Atomic write + CRM webhook</span>
  <span class="text-purple-400">await</span> db.<span class="text-sky-300">transaction</span>(tx =&gt; tx.<span class="text-sky-300">insert</span>(orders).<span class="text-sky-300">values</span>(quote));
  <span class="text-purple-400">return</span> &#123; status: <span class="text-[#00E599]">'shipped'</span>, latencyMs: <span class="text-amber-300">38</span> &#125;;
&#125;</code></pre>
                <div class="mt-4 flex flex-wrap gap-2 font-mono text-[11px]">
                  <span class="px-2.5 py-1 bg-[#00E599]/10 text-[#00E599] border border-[#00E599]/30">✓ tsc --noEmit (0 errors)</span>
                  <span class="px-2.5 py-1 bg-[#00E599]/10 text-[#00E599] border border-[#00E599]/30">✓ 42 unit tests passed</span>
                  <span class="px-2.5 py-1 bg-white/5 text-zinc-300 border border-white/10">PR #18 merged → main</span>
                </div>
              </div>

              <!-- STAGE 2: High-Craft Product UI Dashboard -->
              <div data-story-stage="2" class="story-stage-pane absolute inset-6 sm:inset-8 z-10 flex flex-col justify-center transition-all duration-500 opacity-0 scale-[0.97] pointer-events-none">
                <div class="flex items-center justify-between font-mono text-[11px] text-[#00E599] mb-4">
                  <span>INTERFACE // CONVERSION_SYSTEM</span>
                  <span class="px-2 py-0.5 border border-[#00E599]/35 bg-[#00E599]/10">03 / 04</span>
                </div>
                <div class="border border-white/10 bg-black/75 p-5 space-y-5">
                  <div class="grid grid-cols-3 border swiss-frame divide-x divide-white/[0.08]">
                    <div class="p-3.5">
                      <p class="text-[10px] font-mono text-zinc-500">MRR GROWTH</p>
                      <p class="text-xl font-display font-bold text-white mt-1">$48.2k</p>
                      <p class="text-[10px] text-[#00E599] font-mono">+34% MoM</p>
                    </div>
                    <div class="p-3.5">
                      <p class="text-[10px] font-mono text-zinc-500">AUTO-HANDLED</p>
                      <p class="text-xl font-display font-bold text-[#00E599] mt-1">94.6%</p>
                      <p class="text-[10px] text-zinc-400 font-mono">AI Pipeline</p>
                    </div>
                    <div class="p-3.5">
                      <p class="text-[10px] font-mono text-zinc-500">RESPONSE</p>
                      <p class="text-xl font-display font-bold text-sky-400 mt-1">0.4s</p>
                      <p class="text-[10px] text-zinc-400 font-mono">p99 Edge</p>
                    </div>
                  </div>
                  <div class="flex items-end gap-2 h-24 pt-2 px-1">
                    <div class="flex-1 bg-white/10 h-[32%]"></div>
                    <div class="flex-1 bg-white/15 h-[46%]"></div>
                    <div class="flex-1 bg-white/20 h-[54%]"></div>
                    <div class="flex-1 bg-[#00E599]/40 h-[70%]"></div>
                    <div class="flex-1 bg-[#00E599]/65 h-[84%]"></div>
                    <div class="flex-1 bg-[#00E599] h-[100%] shadow-[0_0_24px_rgba(0,229,153,0.45)]"></div>
                  </div>
                </div>
              </div>

              <!-- STAGE 3: Production Launch Command Center -->
              <div data-story-stage="3" class="story-stage-pane absolute inset-6 sm:inset-8 z-10 flex flex-col justify-center transition-all duration-500 opacity-0 scale-[0.97] pointer-events-none">
                <div class="flex items-center justify-between font-mono text-[11px] text-[#00E599] mb-4">
                  <span>PRODUCTION // LIVE_RELEASE_VERIFIED</span>
                  <span class="px-2 py-0.5 border border-[#00E599]/35 bg-[#00E599]/10">04 / 04</span>
                </div>
                <div class="border border-[#00E599]/30 bg-[#00E599]/[0.04] p-6 text-center space-y-5">
                  <div class="w-12 h-12 mx-auto border border-[#00E599]/50 bg-[#00E599]/15 flex items-center justify-center text-[#00E599] text-xl font-bold">
                    ✓
                  </div>
                  <div>
                    <p class="text-xl font-display font-bold text-white">Production Deployed Globally</p>
                    <p class="text-xs font-mono text-[#00E599] mt-1">Cloudflare Edge · SSL Strict · PostHog Telemetry Active</p>
                  </div>
                  <div class="grid grid-cols-2 sm:grid-cols-4 border swiss-frame divide-x divide-white/[0.08] bg-black/60 text-xs font-mono">
                    <div class="p-3">
                      <span class="block text-[#00E599] font-bold">99.98%</span>
                      <span class="text-[10px] text-zinc-400">Uptime SLA</span>
                    </div>
                    <div class="p-3">
                      <span class="block text-[#00E599] font-bold">100/100</span>
                      <span class="text-[10px] text-zinc-400">Core Vitals</span>
                    </div>
                    <div class="p-3">
                      <span class="block text-white font-bold">100% IP</span>
                      <span class="text-[10px] text-zinc-400">Client Repo</span>
                    </div>
                    <div class="p-3">
                      <span class="block text-amber-300 font-bold">30 Days</span>
                      <span class="text-[10px] text-zinc-400">Warranty</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Kinetic Scroll-Velocity Oversized Statement Band -->
  <div class="border-t swiss-frame py-7 overflow-hidden bg-[#07080C]">
    <div
      data-kinetic-band
      class="whitespace-nowrap font-display font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-[-0.04em] text-white/[0.11] select-none"
    >
      PRECISION ARCHITECTURE <span class="text-[#00E599]/35">·</span> ZERO MIDDLEMEN <span class="text-[#00E599]/35">·</span> 100% GITHUB OWNERSHIP <span class="text-[#00E599]/35">·</span> 48H FREE BLUEPRINT <span class="text-[#00E599]/35">·</span> SHIP IN WEEKS
    </div>
  </div>
</section>
