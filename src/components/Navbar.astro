---
import { homeCopy, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
  enHref?: string;
  ukHref?: string;
}

const { lang, enHref = '/', ukHref = '/uk' } = Astro.props;
const t = homeCopy[lang].nav;
const homeBase = lang === 'uk' ? '/uk' : '/';
---

<header class="sticky top-0 z-50 border-b border-white/[0.07] bg-[#050507]/75 backdrop-blur-2xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Left Logo -->
    <div class="flex items-center shrink-0">
      <a href={homeBase} class="flex items-center gap-2.5" aria-label="VanzaLabs home">
        <img src="/images/vanzalabs_logo_white_text.png" alt="VanzaLabs" class="h-4 w-auto" width="110" height="16" />
      </a>
    </div>

    <!-- Center Navigation -->
    <nav class="hidden lg:flex items-center gap-6 text-[13px] font-medium text-zinc-400">
      <a href={`${homeBase}#story`} class="hover:text-white transition">{t.story}</a>
      <a href={`${homeBase}#simulator`} class="hover:text-white transition">{t.simulator}</a>
      <a href={`${homeBase}#estimator`} class="hover:text-white transition">{t.estimator}</a>
      <a href={`${homeBase}#lab`} class="hover:text-white transition">{t.products}</a>
      <a href={`${homeBase}#founders`} class="hover:text-white transition">{t.founders}</a>
      <a href="/blog/" class="hover:text-white transition">{lang === 'uk' ? 'Блог' : 'Blog'}</a>
    </nav>

    <!-- Right Controls: Language + Primary CTA -->
    <div class="hidden lg:flex items-center gap-3">
      <div class="inline-flex items-center rounded-lg border border-white/10 bg-white/[0.03] p-0.5 text-[11px] font-mono font-semibold">
        <a
          href={enHref}
          class:list={[
            'px-2.5 py-1 rounded-md transition',
            lang === 'en' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white',
          ]}
        >
          EN
        </a>
        <a
          href={ukHref}
          class:list={[
            'px-2.5 py-1 rounded-md transition',
            lang === 'uk' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white',
          ]}
        >
          UA
        </a>
      </div>

      <a
        href={`${homeBase}#contact`}
        class="inline-flex items-center gap-1.5 rounded-lg bg-[#00E599] hover:bg-[#34F5B4] text-black font-bold text-xs px-4 py-2.5 leading-none transition glow-accent whitespace-nowrap"
      >
        <span>{t.cta}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Mobile Quick Controls + Menu Trigger -->
    <div class="flex lg:hidden items-center gap-2">
      <div class="inline-flex items-center rounded-lg border border-white/10 bg-white/[0.03] p-0.5 text-[11px] font-mono font-semibold">
        <a
          href={enHref}
          class:list={[
            'px-2 py-1 rounded-md transition',
            lang === 'en' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white',
          ]}
        >
          EN
        </a>
        <a
          href={ukHref}
          class:list={[
            'px-2 py-1 rounded-md transition',
            lang === 'uk' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white',
          ]}
        >
          UA
        </a>
      </div>

      <button
        id="mobileMenuBtn"
        type="button"
        class="w-10 h-10 flex items-center justify-center rounded-lg text-zinc-300 hover:text-white hover:bg-white/5 transition"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg data-menu-icon="open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg data-menu-icon="close" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobileMenu" class="hidden lg:hidden border-t border-white/[0.08] bg-[#08090D]/95 backdrop-blur-2xl">
    <div class="px-4 py-4 divide-y divide-white/[0.06] text-[15px] font-medium text-zinc-200">
      <a href={`${homeBase}#story`} class="mobile-nav-link block py-3 hover:text-[#00E599] transition">{t.story}</a>
      <a href={`${homeBase}#simulator`} class="mobile-nav-link block py-3 hover:text-[#00E599] transition">{t.simulator}</a>
      <a href={`${homeBase}#estimator`} class="mobile-nav-link block py-3 hover:text-[#00E599] transition">{t.estimator}</a>
      <a href={`${homeBase}#lab`} class="mobile-nav-link block py-3 hover:text-[#00E599] transition">{t.products}</a>
      <a href={`${homeBase}#founders`} class="mobile-nav-link block py-3 hover:text-[#00E599] transition">{t.founders}</a>
      <a href="/blog/" class="mobile-nav-link block py-3 hover:text-[#00E599] transition">{lang === 'uk' ? 'Блог' : 'Blog'}</a>
      <div class="pt-4">
        <a
          href={`${homeBase}#contact`}
          class="mobile-nav-link w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[#00E599] hover:bg-[#34F5B4] text-black font-bold px-4 py-3.5 text-sm glow-accent transition"
        >
          <span>{t.cta}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</header>
