---
import { type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isUk = lang === 'uk';

const ui = {
  eyebrow: isUk ? '02 // Інтерактивне демо автоматизації' : '02 // Live Automation Demo',
  title: isUk ? 'Як AI-агент замінює 40% ручної рутини.' : 'Watch an AI agent replace 40% of manual ops.',
  subtitle: isUk
    ? 'Оберіть типову бізнес-ситуацію та натисніть «Запустити» — побачите, що саме відбувається за 0.4 секунди замість годин роботи менеджера.'
    : 'Pick a real business bottleneck and hit Run — see the exact CRM deals, replies, and alerts executed automatically in 0.4 seconds instead of hours.',
  runBtn: isUk ? 'Запустити тест' : 'Run Live Test',
  runningBtn: isUk ? 'Агент працює...' : 'Agent running...',
  beforeLabel: isUk ? 'ВХІДНИЙ ЗАПИТ (ЯК БУЛО)' : 'INCOMING EVENT (MANUAL)',
  afterLabel: isUk ? 'АВТОМАТИЧНИЙ РЕЗУЛЬТАТ (ЗА < 1 СЕК)' : 'AUTOMATED OUTCOME (< 1 SEC)',
  humanTab: isUk ? 'Для бізнесу' : 'Business View',
  jsonTab: 'JSON',
  cta: isUk ? 'Хочу таку автоматизацію в бізнес →' : 'Build this workflow for my business →',
  steps: isUk
    ? ['AI читає та розуміє суть', 'Оновлює CRM / Таблиці', 'Миттєво відповідає клієнту']
    : ['AI reads & extracts data', 'Updates CRM & ERP', 'Replies to client instantly'],
  scenarios: isUk
    ? [
        {
          id: 'lead',
          tab: 'Новий клієнт у Telegram',
          source: 'Telegram · 23:14 (неробочий час)',
          sender: 'Олександр · Логістика (Варшава)',
          message: '«Привіт! Маємо компанію на 40 людей, потрібен клієнтський портал з HubSpot і Stripe. Бюджет близько $12k, запуск за 6 тижнів.»',
          manualPain: 'Вручну: менеджер відповість лише зранку (~9 год очікування)',
          autoGain: 'AI-агент: оброблено за 0.4 сек · 0 втрачених лідів',
          actions: [
            { app: 'HubSpot CRM', tag: 'СТВОРЕНО УГОДУ', title: 'Логістичний портал · $12,000', detail: 'Статус: Гарячий лід · Теги: HubSpot, Stripe, 6 тижнів' },
            { app: 'Telegram Відповідь', tag: 'НАДІСЛАНО ЗА 0.4с', title: 'Персональна відповідь клієнту', detail: '«Олександре, ми отримали запит! Ось орієнтовний план на 6 тижнів і посилання на зручний слот завтра о 10:00.»' },
            { app: 'Сповіщення власнику', tag: 'SLACK / TG', title: 'Коротке резюме для фаундера', detail: 'Бюджет підтверджено ($12k) · Дзвінок запропоновано автоматично.' },
          ],
          json: `{\n  "intent": "qualified_b2b_lead",\n  "budget_usd": 12000,\n  "integrations": ["HubSpot", "Stripe"],\n  "crm_deal_id": "#4821",\n  "reply_sent_ms": 410\n}`,
        },
        {
          id: 'invoice',
          tab: 'Рахунок у PDF на пошту',
          source: 'Email · Вкладення PDF (3 стор.)',
          sender: 'Nordic Supply GmbH · accounting@nordic.de',
          message: 'supplier_inv_9042.pdf — Сума: €4,850.00 · 12 товарних позицій · Термін оплати: 14 днів · VAT DE2948102',
          manualPain: 'Вручну: ~35 хв на перевірку 12 рядків та перенесення в облік',
          autoGain: 'AI-агент: звірено за 0.7 сек · Точність 99.7%',
          actions: [
            { app: 'OCR + AI Звірка', tag: '12 / 12 ПОЗИЦІЙ', title: 'Повна відповідність замовленню #1104', detail: 'Ціни, ПДВ та реквізити збігаються. Розбіжностей: 0.' },
            { app: 'Облік / Google Sheets', tag: 'ДОДАНО РЯДОК', title: '€4,850.00 поставлено в платіжний календар', detail: 'Створено чернетку платежу з дедлайном через 14 днів.' },
            { app: 'Підпис CFO', tag: '1-КЛІК TELEGRAM', title: 'Надіслано кнопку «Погодити оплату»', detail: 'Фіндиректор підтверджує платіж одним тапом без відкриття PDF.' },
          ],
          json: `{\n  "vendor": "Nordic Supply GmbH",\n  "total_eur": 4850.00,\n  "matched_items": "12/12",\n  "discrepancies": 0,\n  "status": "queued_for_1tap_approval"\n}`,
        },
        {
          id: 'support',
          tab: 'Терміновий запит клієнта',
          source: 'Чат підтримки · Субота 17:40',
          sender: 'Клієнт #8492 · Склад Київ',
          message: '«Де зараз наше замовлення #8492? Склад зачиняється о 18:00 і нам терміново потрібна накладна PDF!»',
          manualPain: 'Вручну: саппорт шукає у 3 таблицях ~20 хв або не відповідає у вихідний',
          autoGain: 'AI-агент: вирішено за 0.3 сек · 68% тікетів без людей',
          actions: [
            { app: 'API Перевізника', tag: 'LIVE-СТАТУС', title: 'Вантаж #8492 пройшов сортування', detail: 'Кур’єр на маршруті · Точне прибуття: сьогодні о 17:52.' },
            { app: 'База знань (RAG)', tag: 'ЗНАЙДЕНО PDF', title: 'Прикріплено накладну #8492.pdf', detail: 'Автоматично витягнуто підписаний документ із Google Drive.' },
            { app: 'Відповідь клієнту', tag: 'ТІКЕТ ЗАКРИТО', title: 'Клієнт отримав статус + PDF за 0.3с', detail: 'Нуль ескалації на команду підтримки у вихідний день.' },
          ],
          json: `{\n  "order_id": "#8492",\n  "eta": "17:52 today",\n  "attachment": "waybill_8492.pdf",\n  "human_escalation": false,\n  "resolved_ms": 320\n}`,
        },
      ]
    : [
        {
          id: 'lead',
          tab: 'New Telegram Lead',
          source: 'Telegram · 11:14 PM (After Hours)',
          sender: 'Alex · Logistics Firm (Warsaw)',
          message: '"Hey! We run a 40-person logistics company and need a client portal synced with HubSpot & Stripe. Budget ~$12k, ideally live in 6 weeks."',
          manualPain: 'Manual: Sales rep replies next morning (~9 hrs delay)',
          autoGain: 'AI Agent: Handled in 0.4s · Zero missed leads',
          actions: [
            { app: 'HubSpot CRM', tag: 'DEAL CREATED', title: 'Warsaw Client Portal · $12,000', detail: 'Stage: Qualified Hot Lead · Tags: HubSpot, Stripe, 6 weeks' },
            { app: 'Telegram Auto-Reply', tag: 'SENT IN 0.4s', title: 'Tailored response sent to Alex', detail: '"Hi Alex! Got your brief — here is a 6-week roadmap overview and a direct link to lock a 20-min call tomorrow at 10:00 CET."' },
            { app: 'Founder Brief', tag: 'SLACK / TG', title: 'Instant qualified alert to founders', detail: 'Budget verified ($12k) · Discovery call link delivered automatically.' },
          ],
          json: `{\n  "intent": "qualified_b2b_lead",\n  "budget_usd": 12000,\n  "integrations": ["HubSpot", "Stripe"],\n  "crm_deal_id": "#4821",\n  "reply_sent_ms": 410\n}`,
        },
        {
          id: 'invoice',
          tab: 'Supplier PDF Invoice',
          source: 'Email · PDF Attachment (3 pages)',
          sender: 'Nordic Supply GmbH · accounting@nordic.de',
          message: 'supplier_inv_9042.pdf — Total: €4,850.00 · 12 line items · Net 14 · VAT DE2948102',
          manualPain: 'Manual: ~35 mins cross-checking 12 lines & entering ERP data',
          autoGain: 'AI Agent: Reconciled in 0.7s · 99.7% accuracy',
          actions: [
            { app: 'AI OCR Verification', tag: '12 / 12 MATCHED', title: 'Verified against Purchase Order #1104', detail: 'Unit prices, VAT ID, and totals match. Discrepancies: 0.' },
            { app: 'Xero / Sheets Sync', tag: 'ROW LOGGED', title: '€4,850.00 queued in payout ledger', detail: 'Draft payout scheduled automatically for Net 14 due date.' },
            { app: 'CFO Sign-off', tag: '1-TAP TELEGRAM', title: 'One-tap approval button sent to CFO', detail: 'Finance approves payout in 2 seconds without opening spreadsheets.' },
          ],
          json: `{\n  "vendor": "Nordic Supply GmbH",\n  "total_eur": 4850.00,\n  "matched_items": "12/12",\n  "discrepancies": 0,\n  "status": "queued_for_1tap_approval"\n}`,
        },
        {
          id: 'support',
          tab: 'Urgent Support Ticket',
          source: 'Web Chat · Saturday 5:40 PM',
          sender: 'Client #8492 · Warehouse Ops',
          message: '"Where is shipment #8492? Our dock closes at 18:00 CET and we urgently need the customs declaration PDF!"',
          manualPain: 'Manual: 20+ mins checking 3 tools or unanswered on weekend',
          autoGain: 'AI Agent: Resolved in 0.3s · 68% tickets automated',
          actions: [
            { app: 'Carrier Tracking API', tag: 'LIVE STATUS', title: 'Shipment #8492 cleared customs', detail: 'Courier en route · Exact ETA: Today at 17:52 CET.' },
            { app: 'Company RAG Vault', tag: 'PDF ATTACHED', title: 'Retrieved customs_decl_8492.pdf', detail: 'Automatically fetched verified PDF from Google Drive.' },
            { app: 'Client Chat Reply', tag: 'AUTO-RESOLVED', title: 'Delivered ETA + PDF in 0.3s', detail: 'Zero weekend escalation needed for your support team.' },
          ],
          json: `{\n  "order_id": "#8492",\n  "eta": "17:52 CET today",\n  "attachment": "customs_decl_8492.pdf",\n  "human_escalation": false,\n  "resolved_ms": 320\n}`,
        },
      ],
};

const simConfigJson = JSON.stringify({
  runBtn: ui.runBtn,
  runningBtn: ui.runningBtn,
  scenarios: ui.scenarios,
});
---

<section id="simulator" class="py-20 lg:py-28 border-b swiss-frame relative overflow-hidden bg-[#06070A]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div data-reveal class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-8 mb-10 border-b swiss-frame">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#00E599] mb-2">{ui.eyebrow}</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-[-0.03em]">{ui.title}</h2>
      </div>
      <p class="text-zinc-400 text-sm sm:text-base max-w-md">{ui.subtitle}</p>
    </div>

    <div id="aiSimRoot" data-config={simConfigJson} class="swiss-cell crosshair border">
      <!-- Top Control Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 p-5 sm:p-6 border-b swiss-frame bg-black/40">
        <div class="flex flex-wrap gap-2">
          {ui.scenarios.map((sc, idx) => (
            <button
              type="button"
              data-sim-scenario={sc.id}
              data-cursor="SWITCH"
              class:list={[
                'sim-scenario-btn px-4 py-2 text-xs sm:text-sm font-semibold border transition cursor-pointer',
                idx === 0
                  ? 'bg-white text-black border-white'
                  : 'bg-transparent border-white/15 text-zinc-400 hover:text-white hover:border-white/35',
              ]}
            >
              {sc.tab}
            </button>
          ))}
        </div>

        <div class="flex items-center gap-3">
          <!-- Business View vs Raw JSON Toggle -->
          <div class="inline-flex border border-white/15 p-0.5 text-[11px] font-mono bg-black/50">
            <button id="simModeHuman" type="button" class="px-2.5 py-1 bg-white/15 text-white cursor-pointer">{ui.humanTab}</button>
            <button id="simModeJson" type="button" class="px-2.5 py-1 text-zinc-400 hover:text-white cursor-pointer">{ui.jsonTab}</button>
          </div>

          <button
            id="simRunBtn"
            type="button"
            data-cursor="RUN"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#00E599] hover:bg-[#34F5B4] text-black font-bold text-xs sm:text-sm transition cursor-pointer glow-accent"
          >
            <span>▶</span>
            <span id="simRunLabel">{ui.runBtn}</span>
          </button>
        </div>
      </div>

      <!-- 3-Step Visual Engine Strip -->
      <div class="grid sm:grid-cols-3 border-b swiss-frame divide-y sm:divide-y-0 sm:divide-x divide-white/[0.08] bg-black/30">
        {ui.steps.map((step, i) => (
          <div data-sim-step={i} class="sim-step px-6 py-4 flex items-center gap-3 transition-all duration-300">
            <span class="sim-step-badge w-6 h-6 flex items-center justify-center font-mono text-[11px] font-bold border border-[#00E599] bg-[#00E599]/15 text-[#00E599]">
              0{i + 1}
            </span>
            <span class="text-xs sm:text-sm font-medium text-zinc-200">{step}</span>
          </div>
        ))}
      </div>

      <!-- Main Split: Incoming Event (Left) → Automated Business Actions (Right) -->
      <div class="grid lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-white/[0.08]">
        <!-- LEFT: Incoming Business Event (5 cols) -->
        <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between space-y-6 bg-black/25">
          <div class="space-y-4">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-zinc-500">{ui.beforeLabel}</p>

            <!-- Realistic Incoming Message Card -->
            <div class="p-5 border border-white/12 bg-[#0D1017] space-y-3">
              <div class="flex items-center justify-between gap-2 text-[11px] font-mono">
                <span id="simSource" class="text-sky-400">{ui.scenarios[0].source}</span>
                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
              </div>
              <p id="simSender" class="text-xs font-bold text-white">{ui.scenarios[0].sender}</p>
              <p id="simMessage" class="text-sm text-zinc-300 leading-relaxed">{ui.scenarios[0].message}</p>
            </div>
          </div>

          <!-- Before vs After Impact Comparison -->
          <div class="space-y-2.5 pt-4 border-t swiss-frame text-xs font-mono">
            <div class="flex items-start gap-2 text-rose-300/85">
              <span>✕</span>
              <span id="simManualPain">{ui.scenarios[0].manualPain}</span>
            </div>
            <div class="flex items-start gap-2 text-[#00E599]">
              <span>✓</span>
              <span id="simAutoGain">{ui.scenarios[0].autoGain}</span>
            </div>
          </div>
        </div>

        <!-- RIGHT: Tangible Business Outcome Cards (7 cols) -->
        <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between space-y-6 bg-black/45">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#00E599] mb-4">{ui.afterLabel}</p>

            <!-- Human-Friendly Action Cards View -->
            <div id="simHumanView" class="space-y-3">
              {ui.scenarios[0].actions.map((act, idx) => (
                <div
                  data-sim-action={idx}
                  class="sim-action-card p-4 border border-[#00E599]/25 bg-[#00E599]/[0.04] transition-all duration-300"
                >
                  <div class="flex items-center justify-between gap-2 mb-1 font-mono text-[10px]">
                    <span class="text-zinc-300 font-semibold">{act.app}</span>
                    <span class="px-2 py-0.5 bg-[#00E599]/15 text-[#00E599] border border-[#00E599]/30">{act.tag}</span>
                  </div>
                  <p class="text-sm font-bold text-white mb-0.5">{act.title}</p>
                  <p class="text-xs text-zinc-400 leading-relaxed">{act.detail}</p>
                </div>
              ))}
            </div>

            <!-- Developer Raw JSON View (hidden by default) -->
            <pre
              id="simJsonView"
              class="hidden p-5 border border-white/10 bg-black/80 font-mono text-xs text-[#00E599]/90 leading-relaxed overflow-x-auto whitespace-pre-wrap"
            >{ui.scenarios[0].json}</pre>
          </div>

          <div class="pt-4 border-t swiss-frame flex justify-end">
            <button
              type="button"
              data-prefill-service="automation"
              class="prefill-cta text-xs sm:text-sm font-mono font-bold text-white hover:text-[#00E599] transition cursor-pointer"
            >
              {ui.cta}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function bindVisualSimulator() {
      const root = document.getElementById('aiSimRoot');
      if (!root || root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const cfg = JSON.parse(root.dataset.config || '{}');

      let activeId = cfg.scenarios[0].id;
      let running = false;

      const sourceEl = document.getElementById('simSource');
      const senderEl = document.getElementById('simSender');
      const msgEl = document.getElementById('simMessage');
      const painEl = document.getElementById('simManualPain');
      const gainEl = document.getElementById('simAutoGain');
      const humanView = document.getElementById('simHumanView');
      const jsonView = document.getElementById('simJsonView');
      const runBtn = document.getElementById('simRunBtn');
      const runLabel = document.getElementById('simRunLabel');
      const btnHuman = document.getElementById('simModeHuman');
      const btnJson = document.getElementById('simModeJson');
      const stepEls = root.querySelectorAll('.sim-step');

      function setViewMode(mode) {
        const isJson = mode === 'json';
        humanView?.classList.toggle('hidden', isJson);
        jsonView?.classList.toggle('hidden', !isJson);
        if (btnHuman) btnHuman.className = `px-2.5 py-1 cursor-pointer ${!isJson ? 'bg-white/15 text-white' : 'text-zinc-400 hover:text-white'}`;
        if (btnJson) btnJson.className = `px-2.5 py-1 cursor-pointer ${isJson ? 'bg-white/15 text-white' : 'text-zinc-400 hover:text-white'}`;
      }

      btnHuman?.addEventListener('click', () => setViewMode('human'));
      btnJson?.addEventListener('click', () => setViewMode('json'));

      function populateActionCards(sc, dimAll) {
        if (!humanView) return;
        humanView.innerHTML = sc.actions
          .map(
            (act, idx) => `
          <div data-sim-action="${idx}" class="sim-action-card p-4 border transition-all duration-300 ${
              dimAll
                ? 'border-white/[0.06] bg-white/[0.01] opacity-20 translate-y-2'
                : 'border-[#00E599]/25 bg-[#00E599]/[0.04] opacity-100 translate-y-0'
            }">
            <div class="flex items-center justify-between gap-2 mb-1 font-mono text-[10px]">
              <span class="text-zinc-300 font-semibold">${act.app}</span>
              <span class="px-2 py-0.5 bg-[#00E599]/15 text-[#00E599] border border-[#00E599]/30">${act.tag}</span>
            </div>
            <p class="text-sm font-bold text-white mb-0.5">${act.title}</p>
            <p class="text-xs text-zinc-400 leading-relaxed">${act.detail}</p>
          </div>`
          )
          .join('');
      }

      async function runScenario(id) {
        if (running) return;
        running = true;
        activeId = id;
        const sc = cfg.scenarios.find((s) => s.id === id) || cfg.scenarios[0];

        root.querySelectorAll('.sim-scenario-btn').forEach((b) => {
          const act = b.dataset.simScenario === activeId;
          b.className = `sim-scenario-btn px-4 py-2 text-xs sm:text-sm font-semibold border transition cursor-pointer ${
            act
              ? 'bg-white text-black border-white'
              : 'bg-transparent border-white/15 text-zinc-400 hover:text-white hover:border-white/35'
          }`;
        });

        if (sourceEl) sourceEl.textContent = sc.source;
        if (senderEl) senderEl.textContent = sc.sender;
        if (msgEl) msgEl.textContent = sc.message;
        if (painEl) painEl.textContent = sc.manualPain;
        if (gainEl) gainEl.textContent = sc.autoGain;
        if (jsonView) jsonView.textContent = sc.json;
        if (runLabel) runLabel.textContent = cfg.runningBtn;

        // Dim all steps & action cards first
        stepEls.forEach((el) => {
          el.classList.add('opacity-35');
          el.classList.remove('bg-[#00E599]/[0.08]');
        });
        populateActionCards(sc, true);

        const wait = (ms) => new Promise((r) => setTimeout(r, ms));
        const actionCards = root.querySelectorAll('.sim-action-card');

        for (let i = 0; i < stepEls.length; i++) {
          await wait(320);
          stepEls[i].classList.remove('opacity-35');
          stepEls[i].classList.add('bg-[#00E599]/[0.08]');
          if (actionCards[i]) {
            actionCards[i].className =
              'sim-action-card p-4 border border-[#00E599]/35 bg-[#00E599]/[0.06] opacity-100 translate-y-0 transition-all duration-300';
          }
        }

        if (runLabel) runLabel.textContent = cfg.runBtn;
        running = false;

        if (window.posthog) window.posthog.capture('ai_simulator_run', { scenario: activeId });
      }

      root.querySelectorAll('.sim-scenario-btn').forEach((btn) => {
        btn.addEventListener('click', () => runScenario(btn.dataset.simScenario));
      });
      runBtn?.addEventListener('click', () => runScenario(activeId));
    }

    document.addEventListener('astro:page-load', bindVisualSimulator);
    bindVisualSimulator();
  })();
</script>
