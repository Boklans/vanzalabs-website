---
import { type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isUk = lang === 'uk';

const ui = {
  eyebrow: isUk ? '02 // Інтерактивна AI-лабораторія' : '02 // Live AI Neural Ops Console',
  title: isUk ? 'Протестуйте AI-автоматизацію прямо зараз.' : 'Test a live AI automation pipeline right here.',
  subtitle: isUk
    ? 'Оберіть готовий сценарій або впишіть власну рутинну задачу — подивіться, як AI-агент розбирає запит, оновлює CRM і відповідає клієнту за 0.4 секунди.'
    : 'Pick a preset or type your own operational bottleneck — watch our AI router parse entities, sync CRM/ERP, and stream an instant reply in 0.4 seconds.',
  inputPlaceholder: isUk
    ? 'Або впишіть свою задачу: напр. «Щодня 50 заявок в Instagram, вручну переносимо в Google Таблиці...»'
    : 'Or type your own bottleneck: e.g. "We get 50 WhatsApp orders/day and manually copy them to Google Sheets..."',
  runBtn: isUk ? 'Запустити AI' : 'Run AI Router',
  runningBtn: isUk ? 'Аналізує...' : 'Routing...',
  humanTab: isUk ? 'Візуально' : 'Visual',
  jsonTab: 'JSON',
  cta: isUk ? 'Побудувати такий пайплайн під мій бізнес →' : 'Build this exact pipeline for my business →',
  manualLabel: isUk ? 'ВРУЧНУ' : 'MANUAL',
  aiLabel: isUk ? 'VANZA AI AGENT' : 'VANZA AI AGENT',
  savedLabel: isUk ? 'ЕФЕКТ' : 'IMPACT',
  scenarios: isUk
    ? [
        {
          id: 'lead',
          tab: 'Лід у Telegram (23:14)',
          source: 'Telegram Bot · 23:14',
          sender: 'Олександр · Логістика (Варшава)',
          message: 'Привіт! Маємо компанію на 40 людей, потрібен клієнтський портал з HubSpot і Stripe. Бюджет $12,000, запуск за 6 тижнів.',
          entities: ['Бюджет: $12,000', 'Стек: HubSpot + Stripe', 'Дедлайн: 6 тижнів', 'Пріоритет: ГАРЯЧИЙ'],
          manualTime: '~9 год (до ранку)',
          aiTime: '0.41 сек',
          impact: '+38% конверсії лідів',
          cards: [
            { app: 'HubSpot CRM', ms: '110ms', title: 'Створено угоду #4821 · $12,000', detail: 'Етап: Qualified Discovery · Додано теги HubSpot, Stripe, B2B Portal.' },
            { app: 'AI Відповідь клієнту', ms: '290ms', stream: true, title: 'Надіслано персональну відповідь у Telegram', detail: 'Олександре, ми проаналізували запит на портал з HubSpot і Stripe. Реалістичний термін — 5–6 тижнів. Ось календар, щоб зафіксувати 20-хв дзвінок завтра о 10:00.' },
            { app: 'Сповіщення власнику', ms: '410ms', title: 'Миттєвий бриф у Slack / Telegram', detail: 'Кваліфікований B2B лід ($12k). Дзвінок запропоновано автоматично без участі менеджера.' },
          ],
          json: `{\n  "pipeline": "inbound_b2b_router",\n  "confidence": 0.992,\n  "entities": { "budget_usd": 12000, "tools": ["HubSpot", "Stripe"], "weeks": 6 },\n  "actions_executed": ["hubspot.createDeal", "telegram.sendReply", "slack.notifyFounder"],\n  "total_latency_ms": 410\n}`,
        },
        {
          id: 'invoice',
          tab: 'Рахунок PDF (€4,850)',
          source: 'Email · Вкладення PDF',
          sender: 'Nordic Supply GmbH · accounting@nordic.de',
          message: 'supplier_inv_9042.pdf — 3 сторінки · Сума €4,850.00 · 12 позицій · Оплата Net 14 · VAT DE2948102.',
          entities: ['Сума: €4,850.00', '12 / 12 позицій', 'VAT: DE2948102', 'Розбіжностей: 0'],
          manualTime: '~35 хв перевірки',
          aiTime: '0.68 сек',
          impact: 'Економія 22 год / тиж.',
          cards: [
            { app: 'AI OCR + Звірка', ms: '240ms', title: '12 із 12 позицій зійшлися із PO #1104', detail: 'Ціни, кількість і VAT перевірено автоматично. Точність розпізнавання: 99.7%.' },
            { app: 'AI Коментар для CFO', ms: '490ms', stream: true, title: 'Сформовано резюме на погодження', detail: 'Рахунок від Nordic Supply на €4,850.00 повністю відповідає договору. Чернетку платежу створено в обліку з датою оплати через 14 днів.' },
            { app: 'Облік + 1-Клік Підпис', ms: '680ms', title: 'Записано в ERP · Кнопка «Сплатити» в TG', detail: 'Фіндиректор погоджує платіж одним тапом зі смартфона.' },
          ],
          json: `{\n  "pipeline": "invoice_ocr_reconciliation",\n  "confidence": 0.997,\n  "entities": { "vendor": "Nordic Supply GmbH", "total_eur": 4850.00, "items": 12 },\n  "actions_executed": ["ocr.verifyPO", "erp.createDraftPayout", "telegram.requestApproval"],\n  "total_latency_ms": 680\n}`,
        },
        {
          id: 'support',
          tab: 'Саппорт у суботу (17:40)',
          source: 'Web Chat · Вихідний день',
          sender: 'Клієнт #8492 · Склад Київ',
          message: 'Де зараз наше замовлення #8492? Склад зачиняється о 18:00 і нам терміново потрібна накладна PDF!',
          entities: ['Замовлення: #8492', 'Дедлайн: 18:00', 'Документ: Накладна PDF', 'Тон: Терміновий'],
          manualTime: '~25 хв / немає саппорту',
          aiTime: '0.32 сек',
          impact: '68% тікетів без людей',
          cards: [
            { app: 'API Перевізника + RAG', ms: '140ms', title: 'Знайдено трекінг #8492 + PDF накладної', detail: 'Кур’єр на маршруті (ETA 17:52). Підписаний PDF витягнуто з Google Drive.' },
            { app: 'AI Відповідь у чат', ms: '260ms', stream: true, title: 'Клієнт отримав статус і файл за 0.3с', detail: 'Замовлення #8492 вже поруч — кур’єр прибуде о 17:52, до закриття складу. Підписану накладну #8492.pdf прикріпив до цього повідомлення.' },
            { app: 'Лог підтримки', ms: '320ms', title: 'Тікет автоматично закрито (CSAT 5/5)', detail: 'Нуль ескалації на менеджерів у вихідний день.' },
          ],
          json: `{\n  "pipeline": "rag_support_resolver",\n  "confidence": 0.994,\n  "entities": { "order_id": "#8492", "eta": "17:52", "doc": "waybill_8492.pdf" },\n  "actions_executed": ["carrier.getLiveEta", "drive.fetchPdf", "chat.sendWithAttachment"],\n  "total_latency_ms": 320\n}`,
        },
      ]
    : [
        {
          id: 'lead',
          tab: 'Telegram Lead (11:14 PM)',
          source: 'Telegram Bot · 11:14 PM',
          sender: 'Alex · Logistics Firm (Warsaw)',
          message: 'Hey! We run a 40-person firm and need a client portal synced with HubSpot & Stripe. Budget $12,000, ideally live in 6 weeks.',
          entities: ['Budget: $12,000', 'Stack: HubSpot + Stripe', 'Timeline: 6 weeks', 'Intent: HOT LEAD'],
          manualTime: '~9 hrs (next morning)',
          aiTime: '0.41 sec',
          impact: '+38% lead conversion',
          cards: [
            { app: 'HubSpot CRM', ms: '110ms', title: 'Deal #4821 Created · $12,000', detail: 'Stage: Qualified Discovery · Auto-tagged HubSpot, Stripe, B2B Portal.' },
            { app: 'AI Client Auto-Reply', ms: '290ms', stream: true, title: 'Personalized Telegram reply sent', detail: 'Hi Alex! We parsed your HubSpot + Stripe portal brief — 5–6 weeks is right in our sweet spot. Here is a direct link to lock a 20-min call tomorrow at 10:00 CET.' },
            { app: 'Founder Alert', ms: '410ms', title: 'Instant qualified summary in Slack', detail: 'Verified $12k B2B lead. Discovery slot offered automatically with zero rep latency.' },
          ],
          json: `{\n  "pipeline": "inbound_b2b_router",\n  "confidence": 0.992,\n  "entities": { "budget_usd": 12000, "tools": ["HubSpot", "Stripe"], "weeks": 6 },\n  "actions_executed": ["hubspot.createDeal", "telegram.sendReply", "slack.notifyFounder"],\n  "total_latency_ms": 410\n}`,
        },
        {
          id: 'invoice',
          tab: 'PDF Invoice (€4,850)',
          source: 'Email · PDF Attachment',
          sender: 'Nordic Supply GmbH · accounting@nordic.de',
          message: 'supplier_inv_9042.pdf — 3 pages · Total €4,850.00 · 12 line items · Net 14 · VAT DE2948102.',
          entities: ['Total: €4,850.00', '12 / 12 items matched', 'VAT: DE2948102', 'Anomalies: 0'],
          manualTime: '~35 min manual audit',
          aiTime: '0.68 sec',
          impact: 'Saves 22 hrs / week',
          cards: [
            { app: 'AI OCR + PO Match', ms: '240ms', title: '12 of 12 line items matched PO #1104', detail: 'Unit prices, quantities, and VAT ID verified automatically at 99.7% confidence.' },
            { app: 'AI Summary for CFO', ms: '490ms', stream: true, title: 'Executive approval brief generated', detail: 'Nordic Supply invoice for €4,850.00 matches Purchase Order #1104 with zero discrepancies. Draft payout queued in Xero for Net 14.' },
            { app: 'Xero + 1-Tap Signoff', ms: '680ms', title: 'Logged in ERP · Approve button sent', detail: 'Finance approves payout in 1 tap on Telegram without opening spreadsheets.' },
          ],
          json: `{\n  "pipeline": "invoice_ocr_reconciliation",\n  "confidence": 0.997,\n  "entities": { "vendor": "Nordic Supply GmbH", "total_eur": 4850.00, "items": 12 },\n  "actions_executed": ["ocr.verifyPO", "xero.createDraftPayout", "telegram.requestApproval"],\n  "total_latency_ms": 680\n}`,
        },
        {
          id: 'support',
          tab: 'Weekend Ticket (5:40 PM)',
          source: 'Web Chat · Saturday',
          sender: 'Client #8492 · Warehouse Ops',
          message: 'Where is shipment #8492? Our dock closes at 18:00 CET and we urgently need the customs PDF!',
          entities: ['Order: #8492', 'Cutoff: 18:00 CET', 'Doc: Customs PDF', 'Urgency: HIGH'],
          manualTime: '~25 min / offline weekend',
          aiTime: '0.32 sec',
          impact: '68% tickets auto-solved',
          cards: [
            { app: 'Carrier API + RAG', ms: '140ms', title: 'Live ETA + customs PDF retrieved', detail: 'Courier en route (ETA 17:52 CET). Verified customs_decl_8492.pdf pulled from Drive.' },
            { app: 'AI Live Chat Reply', ms: '260ms', stream: true, title: 'Status + PDF delivered in 0.3s', detail: 'Shipment #8492 cleared customs and arrives at 17:52 CET — before your 18:00 cutoff. I have attached customs_decl_8492.pdf directly to this message.' },
            { app: 'Support Telemetry', ms: '320ms', title: 'Ticket auto-resolved (CSAT 5/5)', detail: 'Zero weekend escalation required for human support agents.' },
          ],
          json: `{\n  "pipeline": "rag_support_resolver",\n  "confidence": 0.994,\n  "entities": { "order_id": "#8492", "eta": "17:52 CET", "doc": "customs_decl_8492.pdf" },\n  "actions_executed": ["carrier.getLiveEta", "drive.fetchPdf", "chat.sendWithAttachment"],\n  "total_latency_ms": 320\n}`,
        },
      ],
};

const simConfigJson = JSON.stringify({
  isUk,
  runBtn: ui.runBtn,
  runningBtn: ui.runningBtn,
  scenarios: ui.scenarios,
});
---

<section id="simulator" class="py-20 lg:py-28 border-b swiss-frame relative overflow-hidden bg-[#050609]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div data-reveal class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-8 mb-10 border-b swiss-frame">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#00E599] mb-2">{ui.eyebrow}</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-white tracking-[-0.03em]">{ui.title}</h2>
      </div>
      <p class="text-zinc-400 text-sm sm:text-base max-w-md">{ui.subtitle}</p>
    </div>

    <div id="aiSimRoot" data-config={simConfigJson} class="swiss-cell crosshair border overflow-hidden">
      <!-- Top Bar: Presets + Custom Prompt Input -->
      <div class="p-5 sm:p-6 border-b swiss-frame bg-black/50 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap gap-2">
            {ui.scenarios.map((sc, idx) => (
              <button
                type="button"
                data-sim-scenario={sc.id}
                class:list={[
                  'sim-scenario-btn px-3.5 py-2 text-xs font-mono font-semibold border transition cursor-pointer',
                  idx === 0
                    ? 'bg-white text-black border-white'
                    : 'bg-transparent border-white/15 text-zinc-400 hover:text-white hover:border-white/35',
                ]}
              >
                {sc.tab}
              </button>
            ))}
          </div>

          <div class="inline-flex border border-white/15 p-0.5 text-[11px] font-mono bg-black/60">
            <button id="simModeHuman" type="button" class="px-2.5 py-1 bg-white/15 text-white cursor-pointer">{ui.humanTab}</button>
            <button id="simModeJson" type="button" class="px-2.5 py-1 text-zinc-400 hover:text-white cursor-pointer">{ui.jsonTab}</button>
          </div>
        </div>

        <!-- Try Your Own Business Bottleneck Input -->
        <form id="simCustomForm" class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-1">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-xs text-[#00E599]">❯</span>
            <input
              id="simCustomInput"
              type="text"
              placeholder={ui.inputPlaceholder}
              class="w-full pl-8 pr-4 py-3 bg-[#090B10] border border-white/12 text-white placeholder-zinc-500 focus:border-[#00E599] focus:outline-none text-xs sm:text-sm"
            />
          </div>
          <button
            id="simRunBtn"
            type="submit"
            class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#00E599] hover:bg-[#34F5B4] text-black font-bold text-xs sm:text-sm transition cursor-pointer glow-accent"
          >
            <span>▶</span>
            <span id="simRunLabel">{ui.runBtn}</span>
          </button>
        </form>
      </div>

      <!-- Main 3-Column Neural Ops Graph Stage -->
      <div class="grid lg:grid-cols-12 items-stretch bg-grid-pattern">
        <!-- COL 1: INBOUND LASER SCANNER (4 cols) -->
        <div class="lg:col-span-4 p-6 flex flex-col justify-between border-b lg:border-b-0 lg:border-r swiss-frame bg-[#080A0F]/85">
          <div class="space-y-4">
            <div class="flex items-center justify-between font-mono text-[10px] tracking-[0.16em] text-zinc-500">
              <span>01 // INBOUND STREAM</span>
              <span id="simSource" class="text-sky-400">{ui.scenarios[0].source}</span>
            </div>

            <!-- Message Box with Laser Scan Beam -->
            <div class="relative overflow-hidden border border-white/12 bg-black/70 p-4 space-y-2.5">
              <div
                id="simScanBeam"
                class="hidden absolute left-0 right-0 top-0 h-10 bg-gradient-to-b from-transparent via-[#00E599]/35 to-[#00E599]/80 border-b border-[#00E599] pointer-events-none"
              ></div>
              <p id="simSender" class="text-xs font-bold text-white">{ui.scenarios[0].sender}</p>
              <p id="simMessage" class="text-sm text-zinc-300 leading-relaxed">{ui.scenarios[0].message}</p>
            </div>

            <!-- Extracted AI Entities -->
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-zinc-500 mb-2">
                {isUk ? 'AI ВИДІЛИВ СУТНОСТІ:' : 'EXTRACTED ENTITIES:'}
              </p>
              <div id="simEntities" class="flex flex-wrap gap-1.5">
                {ui.scenarios[0].entities.map((ent) => (
                  <span class="px-2.5 py-1 bg-[#00E599]/10 border border-[#00E599]/30 text-[#00E599] font-mono text-[11px]">
                    {ent}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="pt-5 mt-5 border-t swiss-frame flex items-center justify-between font-mono text-[11px] text-zinc-500">
            <span>MODEL: LLM + RAG</span>
            <span id="simCoreStatus" class="text-[#00E599]">● READY</span>
          </div>
        </div>

        <!-- COL 2: LIVE AI NEURAL ROUTER SVG (3 cols) -->
        <div class="lg:col-span-3 p-6 flex flex-col items-center justify-center border-b lg:border-b-0 lg:border-r swiss-frame bg-black/60 relative overflow-hidden">
          <!-- Animated Fiber-Optic SVG Cables -->
          <svg viewBox="0 0 260 280" class="w-full max-w-[240px] h-auto" fill="none">
            <!-- Input cable -->
            <path d="M 0 140 H 78" stroke="rgba(255,255,255,0.12)" stroke-width="2" />
            <path id="simCableIn" d="M 0 140 H 78" stroke="#00E599" stroke-width="2.2" class="svg-cable-flow" />

            <!-- 3 Output branching fiber cables -->
            <path d="M 182 140 C 218 140, 218 48, 260 48" stroke="rgba(255,255,255,0.12)" stroke-width="2" />
            <path id="simCableOut0" d="M 182 140 C 218 140, 218 48, 260 48" stroke="#00E599" stroke-width="2.2" class="svg-cable-flow" />

            <path d="M 182 140 H 260" stroke="rgba(255,255,255,0.12)" stroke-width="2" />
            <path id="simCableOut1" d="M 182 140 H 260" stroke="#38BDF8" stroke-width="2.2" class="svg-cable-flow" />

            <path d="M 182 140 C 218 140, 218 232, 260 232" stroke="rgba(255,255,255,0.12)" stroke-width="2" />
            <path id="simCableOut2" d="M 182 140 C 218 140, 218 232, 260 232" stroke="#C084FC" stroke-width="2.2" class="svg-cable-flow" />

            <!-- Outer rotating reactor ring -->
            <circle cx="130" cy="140" r="56" stroke="rgba(0,229,153,0.28)" stroke-width="1.2" stroke-dasharray="6 6">
              <animateTransform attributeName="transform" type="rotate" from="0 130 140" to="360 130 140" dur="16s" repeatCount="indefinite" />
            </circle>

            <!-- Core Reactor Node -->
            <circle id="simCoreCircle" cx="130" cy="140" r="46" fill="#07120F" stroke="#00E599" stroke-width="2" />
            <text x="130" y="135" text-anchor="middle" fill="#FFFFFF" font-size="11" font-weight="700" font-family="JetBrains Mono">VANZA AI</text>
            <text id="simCoreMetric" x="130" y="152" text-anchor="middle" fill="#00E599" font-size="10" font-family="JetBrains Mono">0.41 sec</text>
          </svg>

          <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.18em] text-zinc-500 text-center">
            {isUk ? 'Автономна маршрутизація' : 'Autonomous Routing Core'}
          </p>
        </div>

        <!-- COL 3: 3 LIVE EXECUTION RESULT CARDS (5 cols) -->
        <div class="lg:col-span-5 p-6 bg-[#080A0F]/90 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-[10px] tracking-[0.16em] text-[#00E599] mb-4">
              <span>03 // LIVE EXECUTION</span>
              <span>3 PARALLEL ACTIONS</span>
            </div>

            <div id="simHumanView" class="space-y-3">
              {ui.scenarios[0].cards.map((card, i) => (
                <div data-sim-card={i} class="sim-result-card p-4 border border-white/12 bg-white/[0.02] transition-all duration-300">
                  <div class="flex items-center justify-between font-mono text-[10px] mb-1">
                    <span class="text-zinc-200 font-semibold">{card.app}</span>
                    <span class="sim-card-status text-[#00E599]">✓ {card.ms}</span>
                  </div>
                  <p class="text-sm font-bold text-white mb-1">{card.title}</p>
                  <p class:list={['text-xs text-zinc-400 leading-relaxed', card.stream && 'sim-stream-text']}>{card.detail}</p>
                </div>
              ))}
            </div>

            <pre
              id="simJsonView"
              class="hidden p-4 border border-white/10 bg-black/85 font-mono text-xs text-[#00E599]/90 leading-relaxed overflow-x-auto whitespace-pre-wrap"
            >{ui.scenarios[0].json}</pre>
          </div>
        </div>
      </div>

      <!-- Bottom ROI Comparison & Conversion Strip -->
      <div class="grid sm:grid-cols-4 border-t swiss-frame divide-y sm:divide-y-0 sm:divide-x divide-white/[0.08] bg-black/70">
        <div class="px-5 py-4">
          <p class="font-mono text-[10px] text-zinc-500 uppercase">{ui.manualLabel}</p>
          <p id="simManualTime" class="text-sm font-mono font-bold text-rose-400 mt-0.5">{ui.scenarios[0].manualTime}</p>
        </div>
        <div class="px-5 py-4">
          <p class="font-mono text-[10px] text-zinc-500 uppercase">{ui.aiLabel}</p>
          <p id="simAiTime" class="text-sm font-mono font-bold text-[#00E599] mt-0.5">{ui.scenarios[0].aiTime}</p>
        </div>
        <div class="px-5 py-4">
          <p class="font-mono text-[10px] text-zinc-500 uppercase">{ui.savedLabel}</p>
          <p id="simImpact" class="text-sm font-mono font-bold text-white mt-0.5">{ui.scenarios[0].impact}</p>
        </div>
        <div class="px-5 py-4 flex items-center justify-end">
          <button
            id="simApplyCta"
            type="button"
            class="text-xs font-mono font-bold text-[#00E599] hover:text-white transition cursor-pointer text-right"
          >
            {ui.cta}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    function bindNeuralSimulator() {
      const root = document.getElementById('aiSimRoot');
      if (!root || root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const cfg = JSON.parse(root.dataset.config || '{}');
      let activeScenario = cfg.scenarios[0];
      let running = false;

      const customForm = document.getElementById('simCustomForm');
      const customInput = document.getElementById('simCustomInput');
      const runLabel = document.getElementById('simRunLabel');
      const sourceEl = document.getElementById('simSource');
      const senderEl = document.getElementById('simSender');
      const msgEl = document.getElementById('simMessage');
      const entitiesEl = document.getElementById('simEntities');
      const scanBeam = document.getElementById('simScanBeam');
      const coreStatus = document.getElementById('simCoreStatus');
      const coreMetric = document.getElementById('simCoreMetric');
      const humanView = document.getElementById('simHumanView');
      const jsonView = document.getElementById('simJsonView');
      const manualEl = document.getElementById('simManualTime');
      const aiTimeEl = document.getElementById('simAiTime');
      const impactEl = document.getElementById('simImpact');
      const btnHuman = document.getElementById('simModeHuman');
      const btnJson = document.getElementById('simModeJson');
      const applyCta = document.getElementById('simApplyCta');

      function setMode(mode) {
        const isJson = mode === 'json';
        humanView?.classList.toggle('hidden', isJson);
        jsonView?.classList.toggle('hidden', !isJson);
        if (btnHuman) btnHuman.className = `px-2.5 py-1 cursor-pointer ${!isJson ? 'bg-white/15 text-white' : 'text-zinc-400 hover:text-white'}`;
        if (btnJson) btnJson.className = `px-2.5 py-1 cursor-pointer ${isJson ? 'bg-white/15 text-white' : 'text-zinc-400 hover:text-white'}`;
      }
      btnHuman?.addEventListener('click', () => setMode('human'));
      btnJson?.addEventListener('click', () => setMode('json'));

      // Dynamic parser when user types their OWN custom business bottleneck!
      function buildCustomScenario(text) {
        const lower = text.toLowerCase();
        const foundTools = [];
        const toolMap = [
          ['telegram', 'Telegram'], ['instagram', 'Instagram'], ['whatsapp', 'WhatsApp'],
          ['sheet', 'Google Sheets'], ['таблиц', 'Google Sheets'], ['crm', 'CRM'],
          ['hubspot', 'HubSpot'], ['stripe', 'Stripe'], ['pdf', 'PDF Docs'],
          ['email', 'Email'], ['пошт', 'Email'], ['slack', 'Slack'],
          ['notion', 'Notion'], ['shopify', 'Shopify'], ['1c', '1C / ERP'],
        ];
        toolMap.forEach(([k, label]) => {
          if (lower.includes(k) && !foundTools.includes(label)) foundTools.push(label);
        });
        if (!foundTools.length) foundTools.push('CRM', 'Telegram');

        const numMatch = text.match(/\d[\d,.\s]*(\$|€|₴|k|к|%|шт|заявок|orders|leads)?/i);
        const volumeTag = numMatch ? numMatch[0].trim() : (cfg.isUk ? 'Щодня 24/7' : 'Daily 24/7');

        if (cfg.isUk) {
          return {
            id: 'custom',
            source: 'Ваш бізнес-сценарій · Live',
            sender: 'Кастомний запит користувача',
            message: text,
            entities: [`Обсяг: ${volumeTag}`, `Системи: ${foundTools.slice(0, 2).join(' + ')}`, 'Режим: Автономний 24/7'],
            manualTime: '~2–4 год / день вручну',
            aiTime: '0.45 сек',
            impact: 'До −40% витрат на рутину',
            cards: [
              { app: `${foundTools[0]} Тригер`, ms: '120ms', title: `Авто-розпізнавання вхідних даних (${volumeTag})`, detail: `AI-агент перехоплює кожну подію з ${foundTools[0]}, структурує поля й перевіряє дублікати.` },
              { app: 'AI-Агент + Відповідь', ms: '310ms', stream: true, title: 'Миттєва обробка без участі менеджера', detail: `Задачу «${text.slice(0, 72)}${text.length > 72 ? '...' : ''}» переведено в автономний пайплайн з автоматичним контролем якості та миттєвою відповіддю клієнту.` },
              { app: `${foundTools[1] || 'CRM / Таблиці'} Синхронізація`, ms: '450ms', title: 'Дані автоматично оновлено + звіт власнику', detail: 'Усі записи розкладено по поличках у реальному часі з щоденним зведенням у Telegram.' },
            ],
            json: JSON.stringify({ pipeline: 'custom_client_workflow', detected_tools: foundTools, volume: volumeTag, status: 'ready_for_48h_blueprint', latency_ms: 450 }, null, 2),
          };
        }
        return {
          id: 'custom',
          source: 'Custom Business Scenario · Live',
          sender: 'Your Live Input',
          message: text,
          entities: [`Volume: ${volumeTag}`, `Tools: ${foundTools.slice(0, 2).join(' + ')}`, 'Mode: Autonomous 24/7'],
          manualTime: '~2–4 hrs / day manual',
          aiTime: '0.45 sec',
          impact: 'Up to −40% ops overhead',
          cards: [
            { app: `${foundTools[0]} Trigger`, ms: '120ms', title: `Live ingestion & parsing (${volumeTag})`, detail: `Agent captures every incoming ${foundTools[0]} event, validates fields, and deduplicates records automatically.` },
            { app: 'AI Router + Auto-Action', ms: '310ms', stream: true, title: 'Autonomous execution with zero human lag', detail: `Converted "${text.slice(0, 72)}${text.length > 72 ? '...' : ''}" into a structured LLM + API workflow with instant validation and client response.` },
            { app: `${foundTools[1] || 'CRM / Sheets'} Sync`, ms: '450ms', title: 'Real-time sync + executive digest', detail: 'All records synced cleanly into your stack with live anomaly alerts sent to Slack/Telegram.' },
          ],
          json: JSON.stringify({ pipeline: 'custom_client_workflow', detected_tools: foundTools, volume: volumeTag, status: 'ready_for_48h_blueprint', latency_ms: 450 }, null, 2),
        };
      }

      async function streamText(el, fullText) {
        el.textContent = '';
        const words = fullText.split(' ');
        for (let i = 0; i < words.length; i++) {
          el.textContent += (i === 0 ? '' : ' ') + words[i];
          await new Promise((r) => setTimeout(r, 26));
        }
      }

      async function executeScenario(sc) {
        if (running) return;
        running = true;
        activeScenario = sc;

        // Highlight preset tab if matching
        root.querySelectorAll('.sim-scenario-btn').forEach((b) => {
          const isAct = b.dataset.simScenario === sc.id;
          b.className = `sim-scenario-btn px-3.5 py-2 text-xs font-mono font-semibold border transition cursor-pointer ${
            isAct ? 'bg-white text-black border-white' : 'bg-transparent border-white/15 text-zinc-400 hover:text-white hover:border-white/35'
          }`;
        });

        if (runLabel) runLabel.textContent = cfg.runningBtn;
        if (sourceEl) sourceEl.textContent = sc.source;
        if (senderEl) senderEl.textContent = sc.sender;
        if (msgEl) msgEl.textContent = sc.message;
        if (manualEl) manualEl.textContent = sc.manualTime;
        if (aiTimeEl) aiTimeEl.textContent = sc.aiTime;
        if (impactEl) impactEl.textContent = sc.impact;
        if (coreMetric) coreMetric.textContent = 'SCANNING';
        if (coreStatus) coreStatus.textContent = '● PROCESSING';
        if (jsonView) jsonView.textContent = sc.json;

        // Fire laser scan beam across inbound message
        if (scanBeam) {
          scanBeam.classList.remove('hidden', 'ai-scan-beam');
          void scanBeam.offsetWidth;
          scanBeam.classList.add('ai-scan-beam');
        }

        // Render entities staggered
        if (entitiesEl) {
          entitiesEl.innerHTML = sc.entities
            .map((e) => `<span class="px-2.5 py-1 bg-[#00E599]/10 border border-[#00E599]/35 text-[#00E599] font-mono text-[11px] opacity-0 transition-opacity duration-300">${e}</span>`)
            .join('');
        }

        // Render dimmed result cards waiting for fiber pulse
        if (humanView) {
          humanView.innerHTML = sc.cards
            .map(
              (c, i) => `
            <div data-sim-card="${i}" class="sim-result-card p-4 border border-white/[0.06] bg-white/[0.01] opacity-25 translate-y-2 transition-all duration-300">
              <div class="flex items-center justify-between font-mono text-[10px] mb-1">
                <span class="text-zinc-300 font-semibold">${c.app}</span>
                <span class="sim-card-status text-zinc-500">WAITING...</span>
              </div>
              <p class="text-sm font-bold text-white mb-1">${c.title}</p>
              <p class="text-xs text-zinc-400 leading-relaxed ${c.stream ? 'sim-stream-text' : ''}">${c.stream ? '' : c.detail}</p>
            </div>`
            )
            .join('');
        }

        const wait = (ms) => new Promise((r) => setTimeout(r, ms));
        const entChips = entitiesEl?.querySelectorAll('span') || [];
        for (let i = 0; i < entChips.length; i++) {
          await wait(110);
          entChips[i].classList.remove('opacity-0');
        }

        if (coreMetric) coreMetric.textContent = sc.aiTime;

        const cardEls = root.querySelectorAll('.sim-result-card');
        for (let i = 0; i < cardEls.length; i++) {
          await wait(200);
          const cardEl = cardEls[i];
          const cardData = sc.cards[i];
          cardEl.className = 'sim-result-card p-4 border border-white/15 bg-white/[0.03] opacity-100 translate-y-0 transition-all duration-300';
          const statusSpan = cardEl.querySelector('.sim-card-status');
          if (statusSpan) {
            statusSpan.textContent = `✓ ${cardData.ms}`;
            statusSpan.className = 'sim-card-status text-[#00E599]';
          }
          if (cardData.stream) {
            const streamEl = cardEl.querySelector('.sim-stream-text');
            if (streamEl) await streamText(streamEl, cardData.detail);
          }
        }

        if (coreStatus) coreStatus.textContent = '● COMPLETED';
        if (runLabel) runLabel.textContent = cfg.runBtn;
        running = false;

        if (window.posthog) window.posthog.capture('ai_simulator_run', { scenario: sc.id });
      }

      root.querySelectorAll('.sim-scenario-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (customInput) customInput.value = '';
          const found = cfg.scenarios.find((s) => s.id === btn.dataset.simScenario);
          if (found) executeScenario(found);
        });
      });

      customForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = customInput?.value.trim();
        if (val) {
          executeScenario(buildCustomScenario(val));
        } else {
          executeScenario(activeScenario);
        }
      });

      applyCta?.addEventListener('click', () => {
        const sel = document.querySelector('select[name="service"]');
        if (sel) sel.value = 'automation';
        const msg = document.querySelector('textarea[name="message"]');
        if (msg) {
          msg.value = cfg.isUk
            ? `Хочу впровадити AI-автоматизацію за сценарієм:\n«${activeScenario.message}»\n\nДодаткові деталі: `
            : `I want to build an AI automation workflow for:\n"${activeScenario.message}"\n\nAdditional details: `;
        }
        const target = document.getElementById('contact');
        if (window.__lenis && target) window.__lenis.scrollTo(target, { offset: -64 });
        else target?.scrollIntoView({ behavior: 'smooth' });
      });

      // Auto-run once smoothly when scrolled into view so visitors immediately witness the live AI scan!
      let autoPlayed = false;
      const io = new IntersectionObserver(
        (entries) => {
          if (!autoPlayed && entries[0]?.isIntersecting) {
            autoPlayed = true;
            io.disconnect();
            executeScenario(cfg.scenarios[0]);
          }
        },
        { threshold: 0.3 }
      );
      io.observe(root);
    }

    document.addEventListener('astro:page-load', bindNeuralSimulator);
    bindNeuralSimulator();
  })();
</script>
