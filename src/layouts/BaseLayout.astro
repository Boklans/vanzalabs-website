    posthog.init('phc_q5gM7VmNh57nCNKfKQx7KZDNgqaY7UK2mdXjrAzKDRey', {
      api_host: 'https://eu.i.posthog.com',
      defaults: '2026-05-30',
      person_profiles: 'always'
    });
  </script>

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body class="min-h-screen flex flex-col bg-[#050507] text-zinc-100 selection:bg-[#00E599]/25 selection:text-[#00E599]">
  <!-- Subtle tactile film grain -->
  <div class="film-grain" aria-hidden="true"></div>

  <!-- Top Scroll Progress Beam -->
  <div class="fixed top-0 left-0 right-0 h-[2px] z-[60] pointer-events-none bg-white/[0.04]">
    <div id="scrollProgressBar" class="h-full w-full origin-left scale-x-0 bg-gradient-to-r from-[#00E599] via-teal-300 to-sky-400 shadow-[0_0_12px_rgba(0,229,153,0.9)]"></div>
  </div>

  <slot />

  <CommandPalette lang={lang} />

  <script>
    import { mountMotionEngine, cleanupMotionEngine } from '../scripts/scrollMotion';

    document.addEventListener('astro:before-swap', () => {
      cleanupMotionEngine();
    });

    document.addEventListener('astro:page-load', () => {
      mountMotionEngine();
    });
  </script>
</body>
</html>
