---
import BaseLayout from './BaseLayout.astro';
import { siteConfig } from '../data/i18n';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  appName: string;
  packageId?: string;
  icon?: string;
  backHref: string;
  backLabel?: string;
}

const {
  title,
  description,
  canonicalPath,
  appName,
  packageId,
  icon = '/favicon.png',
  backHref,
  backLabel = '← Back',
} = Astro.props;
---

<BaseLayout title={title} description={description} lang="en" canonicalPath={canonicalPath}>
  <header class="sticky top-0 z-50 border-b border-white/[0.06] bg-[#07080B]/85 backdrop-blur-xl">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
      <a href={backHref} class="flex items-center gap-2.5 sm:gap-3 group min-w-0">
        <img src={icon} alt={appName} class="w-9 h-9 rounded-xl object-contain bg-black border border-white/10 p-1 shrink-0" />
        <div class="min-w-0">
          <span class="font-display font-bold text-sm text-white group-hover:text-emerald-400 transition block truncate">{appName}</span>
          {packageId && <span class="block text-[10px] font-mono text-gray-500 truncate">{packageId}</span>}
        </div>
      </a>

      <div class="flex items-center gap-3 shrink-0">
        <div class="inline-flex rounded-full border border-white/10 p-0.5 bg-white/[0.03] text-xs font-mono font-semibold">
          <button id="privBtnEn" type="button" class="px-3 py-1 rounded-full bg-emerald-500 text-gray-950 transition cursor-pointer">EN</button>
          <button id="privBtnUa" type="button" class="px-3 py-1 rounded-full text-gray-400 hover:text-white transition cursor-pointer">UA</button>
        </div>
        <a href={backHref} class="text-xs font-semibold text-gray-400 hover:text-white transition hidden sm:inline-block">{backLabel}</a>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-14 w-full flex-1">
    <article class="glass-panel rounded-2xl sm:rounded-3xl p-5 sm:p-10">
      <div id="privContentEn" class="prose-dark">
        <slot name="en" />
      </div>
      <div id="privContentUa" class="prose-dark hidden">
        <slot name="uk" />
      </div>
    </article>
  </main>

  <footer class="py-8 border-t border-white/[0.06] text-xs text-gray-500">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>© 2026 VanzaLabs. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href={`mailto:${siteConfig.email}`} class="hover:text-gray-300 transition">{siteConfig.email}</a>
        <a href="/" class="hover:text-gray-300 transition">vanzalabs.tech</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    (() => {
      function bindPrivacyLang() {
        const enDiv = document.getElementById('privContentEn');
        const uaDiv = document.getElementById('privContentUa');
        const btnEn = document.getElementById('privBtnEn');
        const btnUa = document.getElementById('privBtnUa');
        if (!enDiv || !uaDiv || !btnEn || !btnUa || btnEn.dataset.bound === 'true') return;
        btnEn.dataset.bound = 'true';

        const setLang = (lang) => {
          const isUa = lang === 'uk';
          enDiv.classList.toggle('hidden', isUa);
          uaDiv.classList.toggle('hidden', !isUa);
          btnUa.className = `px-3 py-1 rounded-full transition cursor-pointer ${isUa ? 'bg-[#00E599] text-black' : 'text-zinc-400 hover:text-white'}`;
          btnEn.className = `px-3 py-1 rounded-full transition cursor-pointer ${!isUa ? 'bg-[#00E599] text-black' : 'text-zinc-400 hover:text-white'}`;
        };

        btnEn.addEventListener('click', () => setLang('en'));
        btnUa.addEventListener('click', () => setLang('uk'));
      }
      document.addEventListener('astro:page-load', bindPrivacyLang);
      bindPrivacyLang();
    })();
  </script>
</BaseLayout>
