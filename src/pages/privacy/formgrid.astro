<PrivacyLayout
  title="Privacy Policy — FormGrid: Forms & Sheets"
  description="Privacy Policy for FormGrid: Forms & Sheets by Vanza Labs."
  canonicalPath="/privacy/formgrid"
  appName="FormGrid: Forms & Sheets"
